.pa-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(20, 12, 8, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pa-panel {
  position: relative;
  width: 600rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.pa-panel-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.pa-title {
  position: relative;
  z-index: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #5a3a22;
}

.pa-hint {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8a7463;
  line-height: 1.45;
}

.pa-avatar-btn {
  display: block;
  margin: 36rpx auto 0;
  padding: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: transparent;
  border: none;
  overflow: visible;
}

.pa-avatar-btn::after {
  border: none;
}

.pa-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #5a3a22;
  box-sizing: border-box;
}

.pa-hint,
.pa-avatar-btn,
.pa-nickname,
.pa-submit-img {
  position: relative;
  z-index: 1;
}

.pa-avatar--ph {
  background: transparent;
}

.pa-nickname {
  margin-top: 28rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #fffaf3;
  border: 3rpx solid #c4a882;
  font-size: 28rpx;
  color: #4a3728;
}

.pa-submit-img {
  display: block;
  width: 100%;
  height: 88rpx;
  margin-top: 32rpx;
}
