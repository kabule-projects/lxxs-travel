.trip-banner {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 25;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.trip-banner-bg {
  width: 100%;
  height: 88rpx;
}

.trip-banner-text {
  position: absolute;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}
