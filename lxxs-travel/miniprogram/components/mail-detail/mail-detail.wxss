.md-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 110;
  background: rgba(20, 12, 8, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.md-panel {
  position: relative;
  width: 600rpx;
  padding: 40rpx 32rpx 36rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #f7efe0;
  border: 6rpx solid #5a3a22;
}

.md-close {
  position: absolute;
  top: -18rpx;
  right: -18rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #5a3a22;
  color: #fff;
  font-size: 36rpx;
  line-height: 52rpx;
  text-align: center;
}

.md-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #5a3a22;
}

.md-image {
  margin: 24rpx auto 0;
  width: 360rpx;
  height: 360rpx;
  border-radius: 12rpx;
  background: #6b4a2e;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.md-image image {
  width: 100%;
  height: 100%;
}

.md-ph {
  color: #f7efe0;
  font-size: 64rpx;
}

.md-story {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #4a3728;
  text-align: center;
  white-space: pre-wrap;
}

.md-claim {
  margin-top: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  background: #c49a6c;
  color: #fffaf3;
  font-size: 28rpx;
}
