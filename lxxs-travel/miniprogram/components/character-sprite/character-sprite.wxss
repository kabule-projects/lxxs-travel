.sprite-wrap {
  position: relative;
  z-index: 5;
  pointer-events: none;
}

.sprite {
  width: 100%;
  display: block;
}

.sprite--float {
  animation: float 3s ease-in-out infinite;
}

.sprite-fallback {
  width: 100%;
  min-height: 160rpx;
  background: rgba(255, 220, 180, 0.85);
  border-radius: 80rpx 80rpx 24rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #4a3728;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
