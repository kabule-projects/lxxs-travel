<view class="inv-mask" wx:if="{{visible}}" catchtap="onClose">
  <view class="inv-panel" catchtap="onStop">
    <image class="inv-panel-bg" src="{{panelBg}}" mode="scaleToFill" />
    <icon-close class="inv-close" src="{{iconClose}}" size="{{64}}" bind:tap="onClose" />

    <view class="inv-tabs" wx:if="{{!lockTab}}">
      <view
        class="inv-tab {{tab === 'food' ? 'inv-tab--on' : ''}}"
        data-tab="food"
        catchtap="onTapTab"
      >美食</view>
      <view
        class="inv-tab {{tab === 'prop' ? 'inv-tab--on' : ''}}"
        data-tab="prop"
        catchtap="onTapTab"
      >道具</view>
    </view>
    <view class="inv-tabs inv-tabs--locked" wx:else>
      <view class="inv-tab inv-tab--on">{{lockLabel}}</view>
    </view>

    <scroll-view class="inv-list" scroll-y>
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="inv-card"
        data-id="{{item.id}}"
        catchtap="onTapItem"
      >
        <view class="inv-icon">
          <image wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFit" />
          <text class="inv-count">{{item.count}}</text>
        </view>
        <view class="inv-meta">
          <text class="inv-name">{{item.name}}</text>
          <text class="inv-desc">{{item.description}}</text>
        </view>
      </view>
      <view wx:if="{{!items.length}}" class="inv-empty">暂无此类物品</view>
    </scroll-view>
  </view>
</view>
