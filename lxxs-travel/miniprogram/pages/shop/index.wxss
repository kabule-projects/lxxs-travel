.shop {
  position: relative;
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.shop-page-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.shop-overlay {
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

/* ── 顶栏 ── */
.shop-hud {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  padding: 8rpx 20rpx 0;
}

.hud-center {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.currency-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 120rpx;
  height: 52rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  border: 3rpx solid #5a3a22;
  background: #fffaf3;
}

.currency-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.currency-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #3a2410;
  line-height: 1;
}

.hud-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: auto;
}

.tabs {
  white-space: nowrap;
  height: 48rpx;
  padding: 4rpx 20rpx 0;
  box-sizing: border-box;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  padding: 0 20rpx;
  margin-right: 10rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #6b5344;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(90, 58, 34, 0.25);
}

.tab--on {
  color: #fffaf3;
  background: #6b4a2e;
  border-color: #5a3a22;
}

/*
 * 展示柜玻璃区域（对齐 page-bg 中柜台）
 * 设计稿 1320×2868：left≈9% right≈9% top≈36% height≈30%
 */
.cabinet-layer {
  position: absolute;
  left: 9%;
  right: 9%;
  top: 36%;
  height: 30%;
  z-index: 3;
}

.goods-swiper {
  width: 100%;
  height: 100%;
}

.shelf-page {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 0 2%;
  box-sizing: border-box;
}

.shelf-row {
  flex: 1;
  display: flex;
  align-items: flex-end;
  min-height: 0;
}

.shelf-slots {
  width: 100%;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
}

.shelf-slot {
  position: relative;
  width: 30%;
  height: 100%;
  max-height: 176rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.shelf-slot--empty {
  pointer-events: none;
}

.shelf-slot--on .slot-icon {
  transform: translateY(-6rpx) scale(1.06);
}

.shelf-slot--sold {
  opacity: 0.45;
}

.slot-icon {
  position: relative;
  z-index: 1;
  width: 112rpx;
  height: 112rpx;
  margin-bottom: -10rpx;
  transition: transform 0.15s ease;
}

.slot-tag {
  position: relative;
  z-index: 4;
  width: 96rpx;
  height: 52rpx;
}

.slot-tag-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.slot-tag-content {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding-bottom: 4rpx;
  box-sizing: border-box;
}

.tag-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #3a2410;
  line-height: 1;
}

.tag-star {
  width: 30rpx;
  height: 30rpx;
}

.page-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -28rpx;
  text-align: center;
  font-size: 20rpx;
  color: #8a7463;
}

/*
 * 底部简介区（对齐 page-bg 中信纸位置）
 * bottom≈14% height≈24% left≈5% right≈26%
 */
.footer-layer {
  position: absolute;
  left: 5%;
  right: 5%;
  bottom: 5%;
  height: 26%;
  z-index: 4;
}

.desc-text {
  position: absolute;
  left: 3%;
  right: 30%;
  top: 8%;
  bottom: 12%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
}

.desc-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3f2e22;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.desc-body {
  flex: 1;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b5344;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.side-btn {
  position: absolute;
  width: 72rpx;
  height: 72rpx;
  z-index: 2;
}

.side-btn--bag {
  right: 4%;
  top: 6%;
}

.side-btn--star {
  right: 4%;
  top: 38%;
}

.buy-btn-img {
  position: absolute;
  right: 2%;
  bottom: 6%;
  width: 200rpx;
  height: 88rpx;
  z-index: 2;
}
