.roof {
  position: relative;
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: #2a1f4e;
}

.layer {
  position: absolute;
  left: 0;
  width: 100%;
  pointer-events: none;
}

.layer-bg {
  top: 0;
  height: 100%;
  z-index: 0;
}

.sky-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
}

/* ── 屋顶底部角色装饰 ── */
.roof-characters {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 220rpx;
  z-index: 5;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: none;
}

.char-shen {
  width: 200rpx;
}

.char-biao {
  width: 110rpx;
  margin-left: -20rpx;
}

.char-mi {
  width: 90rpx;
  margin-right: -12rpx;
}

/* ── 顶栏（同主页/商店） ── */
.roof-hud {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 20rpx 0;
  box-sizing: border-box;
}

.hud-side {
  width: auto;
  flex-shrink: 0;
}

.hud-side--right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.hud-center {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  flex: 1;
}

.currency-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 120rpx;
  height: 52rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  border: 3rpx solid #5a3a22;
  background: #fffaf3;
}

.currency-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.currency-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #3a2410;
  line-height: 1;
}

/* ── 鸽子（屋顶右侧，星星堆在其左下） ── */
.pigeon-spot {
  position: absolute;
  right: 10%;
  bottom: 34%;
  z-index: 6;
  width: 160rpx;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.magic-hat-img {
  width: 108rpx;
  height: 76rpx;
  margin-top: auto;
}

.pigeon-img {
  position: absolute;
  bottom: 62rpx;
  width: 96rpx;
  height: 96rpx;
  transition: transform 0.9s ease-in, opacity 0.9s ease-in;
}

.pigeon-img--mail {
  filter: drop-shadow(0 0 8rpx rgba(232, 146, 58, 0.55));
}

.pigeon-img--fly {
  transform: translate(120rpx, -220rpx) scale(0.4);
  opacity: 0;
}

.mail-tip-img {
  position: absolute;
  top: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
}

.plus-one {
  position: absolute;
  left: -36rpx;
  bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffe27a;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.45);
  animation: plus-pop 0.25s ease-out;
  pointer-events: none;
}

@keyframes plus-pop {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ── 底栏 ── */
.roof-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx 40rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.footer-left,
.footer-right {
  pointer-events: auto;
}

.footer-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20rpx;
}

.btn-prepare-img {
  width: 180rpx;
  display: block;
}
