.home {
  position: relative;
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: #e5d3b3;
}

.home-page-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.home-overlay {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ── 顶栏（布局同商店） ── */
.home-hud {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 20rpx 0;
  flex-shrink: 0;
}

.hud-side {
  width: auto;
  flex-shrink: 0;
}

.hud-side--right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.hud-center {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  flex: 1;
}

.currency-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 120rpx;
  height: 52rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  border: 3rpx solid #5a3a22;
  background: #fffaf3;
}

.currency-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.currency-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #3a2410;
  line-height: 1;
}

/* ── 家具热区 ── */
.hotspot {
  position: absolute;
  z-index: 12;
}

.hotspot-showcase {
  left: 2%;
  top: 14%;
  width: 22%;
  height: 38%;
}

.hotspot-wardrobe {
  right: 2%;
  top: 22%;
  width: 26%;
  height: 34%;
}

.hotspot-diary {
  left: 30%;
  top: 52%;
  width: 22%;
  height: 18%;
}

/* ── 底栏 ── */
.home-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx 40rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.footer-left,
.footer-right {
  pointer-events: auto;
}

.footer-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20rpx;
}

.btn-prepare-img {
  width: 180rpx;
  display: block;
}
