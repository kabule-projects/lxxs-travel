<view class="showcase">
  <image class="showcase-page-bg" src="{{assets.cabinet}}" mode="aspectFill" />

  <!-- 顶栏：padding-top 内联，整体落到胶囊下方（同 home/roof） -->
  <view class="hud" style="padding-top: {{hudTop}}px">
    <nav-icon src="{{assets.iconBack}}" label="返回" size="sm" bind:tap="onTapBack" />
    <nav-icon src="{{assets.iconGrid}}" label="设置" size="sm" bind:tap="onTapSettings" />
  </view>

  <swiper
    class="cabinet-swiper"
    style="{{cabStyle}}"
    current="{{pageIndex}}"
    bindchange="onSwiperChange"
  >
    <swiper-item wx:for="{{pages}}" wx:for-item="pg" wx:for-index="pi" wx:key="pi">
      <view class="cabinet">
        <view class="cabinet-inner">
          <view
            wx:for="{{pg.shelves}}"
            wx:for-item="shelf"
            wx:for-index="si"
            wx:key="si"
            class="shelf"
          >
            <view class="shelf-slots">
              <view
                wx:for="{{shelf}}"
                wx:for-item="cell"
                wx:key="id"
                class="slot {{cell.empty ? 'slot--empty' : ''}}"
                data-id="{{cell.id}}"
                bindtap="onTapItem"
              >
                <image
                  wx:if="{{!cell.empty && cell.icon}}"
                  class="slot-icon"
                  src="{{cell.icon}}"
                  mode="aspectFit"
                />
              </view>
            </view>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="page-hint">{{pageIndex + 1}} / {{totalPages}}</view>

  <showcase-detail
    visible="{{detailVisible}}"
    title="{{detailTitle}}"
    image="{{detailImage}}"
    description="{{detailDesc}}"
    bind:close="onCloseDetail"
    bind:confirm="onCloseDetail"
  />

  <settings-modal visible="{{showSettings}}" bind:close="onCloseSettings" />
</view>
