<view class="showcase">
  <image class="showcase-page-bg" src="{{assets.cabinet}}" mode="aspectFill" />

  <!-- 顶栏：padding-top 内联，整体落到胶囊下方（同 home/roof） -->
  <view class="hud" style="padding-top: {{hudTop}}px">
    <nav-icon src="{{assets.iconBack}}" label="返回" size="sm" bind:tap="onTapBack" />
    <nav-icon src="{{assets.iconGrid}}" label="设置" size="sm" bind:tap="onTapSettings" />
  </view>

  <swiper
    class="cabinet-swiper"
    current="{{pageIndex}}"
    bindchange="onSwiperChange"
  >
    <swiper-item wx:for="{{pages}}" wx:for-item="page" wx:key="index">
      <view class="cabinet">
        <view class="cabinet-inner">
          <view
            wx:for="{{page.shelves}}"
            wx:for-item="shelf"
            wx:for-index="si"
            wx:key="si"
            class="shelf"
          >
            <view class="shelf-slots">
              <view
                wx:for="{{shelf}}"
                wx:for-item="slot"
                wx:key="id"
                class="slot {{slot.empty ? 'slot--empty' : ''}}"
                data-id="{{slot.id}}"
                bindtap="onTapItem"
              >
                <block wx:if="{{!slot.empty}}">
                  <image
                    wx:if="{{slot.icon}}"
                    class="slot-icon"
                    src="{{slot.icon}}"
                    mode="aspectFit"
                  />
                </block>
              </view>
            </view>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="page-hint">{{pageIndex + 1}} / {{totalPages}}</view>

  <!-- 物品栏调试层：常态显示的方块网格，复刻 item 排列逻辑（4 行 × 每行 2 格），
       仅用于对位调整，不响应点击；调完删除此块与对应 wxss -->
  <view class="inv-tune">
    <view
      class="inv-tune__row"
      wx:for="{{[0, 1, 2, 3]}}"
      wx:for-item="row"
      wx:for-index="r"
      wx:key="*this"
    >
      <view
        class="inv-tune__cell"
        wx:for="{{[0, 1]}}"
        wx:for-item="col"
        wx:for-index="c"
        wx:key="*this"
      >{{r * 2 + c + 1}}</view>
    </view>
  </view>

  <showcase-detail
    visible="{{detailVisible}}"
    title="{{detailTitle}}"
    image="{{detailImage}}"
    description="{{detailDesc}}"
    bind:close="onCloseDetail"
  />

  <settings-modal visible="{{showSettings}}" bind:close="onCloseSettings" />
</view>
