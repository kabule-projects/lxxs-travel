.showcase {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #e8d39a;
}

.showcase-page-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

/* 柜子贴图：全屏叠在背景之上、物品之下（z-index:1，swiper 为 2） */
.showcase-cabinet-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}

.hud {
  position: relative;
  z-index: 5;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 整页翻页容器：位置/尺寸由 index.ts 的 cabStyle 内联 px 给定（真机百分比高度链会失效）。
   每页 4 行 × 每行 2 格 = 8 个，排不满时空位保留 */
.cabinet-swiper {
  position: absolute;
  z-index: 2;
}

.cabinet-swiper swiper-item {
  width: 100%;
  height: 100%;
}

/* 格子区铺满 swiper-item */
.cabinet {
  position: relative;
  width: 100%;
  height: 100%;
}

.cabinet-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 每行（共 4 行）：等分柜内高度，格子底对齐 */
.shelf {
  position: relative;
  height: 280rpx;
  margin-bottom: 24rpx;
  min-height: 0;
  display: flex;
  align-items: flex-end;
}

.shelf-slots {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  pointer-events: none;
}

.slot {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: auto;
}

/* NEW 遮罩：尺寸/位置与物品 icon 完全重合（底对齐、水平居中） */
.slot-new {
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 220rpx;
  height: 220rpx;
  z-index: 2;
  pointer-events: none;
}

.slot--empty {
  pointer-events: none;
}

.slot-icon {
  width: 220rpx;
  height: 220rpx;
}

.page-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 5%;
  z-index: 3;
  text-align: center;
  font-size: 24rpx;
  color: #5a4030;
}
