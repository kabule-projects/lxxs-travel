.showcase {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #e8d39a;
}

.showcase-page-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hud {
  position: relative;
  z-index: 5;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cabinet-swiper {
  position: relative;
  z-index: 2;
  flex: 1;
  height: 0;
  min-height: 920rpx;
  margin-top: 12rpx;
}

.cabinet {
  position: relative;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx 80rpx;
  box-sizing: border-box;
}

.cabinet-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 640rpx;
  height: 860rpx;
  padding: 28rpx 24rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.shelf {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 0;
}

.shelf-slots {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 22rpx;
  height: 140rpx;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  pointer-events: none;
}

.slot {
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: auto;
}

.slot--empty {
  pointer-events: none;
}

.slot-icon {
  width: 120rpx;
  height: 120rpx;
}

.page-hint {
  position: relative;
  z-index: 3;
  text-align: center;
  padding-bottom: 28rpx;
  font-size: 24rpx;
  color: #5a4030;
}
