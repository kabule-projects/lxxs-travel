.showcase {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #e8d39a;
}

.showcase-page-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.hud {
  position: relative;
  z-index: 5;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 整页翻页容器：铺满屏幕，内部格子按屏幕百分比绝对定位（与调试网格对位一致） */
.cabinet-swiper {
  position: absolute;
  left: 0;
  top: 20%;
  right: 0;
  bottom: 20%;
  z-index: 2;
}

/* 格子区：整体位置/宽度直接对应屏幕百分比（原 inv-tune 调试网格参数） */
.cabinet {
  position: absolute;
  left: 15%;
  top: 26%;
  width: 70%;
  box-sizing: border-box;
}

.cabinet-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
}

/* 每行（共 4 行）格底对齐 */
.shelf {
  position: relative;
  height: 20%;
  margin-bottom: 10%;
}

.shelf-slots {
  position: relative;
  width: 100%;
  height: 140rpx;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  pointer-events: none;
}

.slot {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: auto;
}

.slot--empty {
  pointer-events: none;
}

.slot-icon {
  width: 120rpx;
  height: 120rpx;
}

.page-hint {
  position: relative;
  z-index: 3;
  text-align: center;
  padding-bottom: 28rpx;
  font-size: 24rpx;
  color: #5a4030;
}
