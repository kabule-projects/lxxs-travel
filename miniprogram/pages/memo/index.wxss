/* 整屏：紫色条纹底铺满，内容垂直居中 */
.memo {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.memo-bg {
  position: absolute;
  left: 0;
  top: 50%;
  width: 100%;
  aspect-ratio: 1321 / 2869;
  transform: translateY(-50%);
}

.memo-bg-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 白色面板：屏幕正中，尺寸由 JS 按屏高换算内联 */
.memo-panel {
  position: relative;
  z-index: 2;
}

.memo-panel-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
}

/* 列表区：面板内部按 mockup 百分比留白（标题占顶部约 23%） */
.memo-list {
  position: absolute;
  left: 7%;
  right: 7%;
  top: 23%;
  bottom: 6%;
  z-index: 2;
}

.memo-row {
  position: relative;
  margin-bottom: 24rpx;
}

.memo-row-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.memo-row-main {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 0 6%;
}

.memo-row-date {
  width: 34%;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #6a5fa8;
}

.memo-row-text {
  flex: 1;
  font-size: 26rpx;
  color: #8a80c0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.memo-empty,
.memo-foot {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9a90c8;
}

.memo-back {
  position: absolute;
  left: 32rpx;
  z-index: 10;
  width: 150rpx;
  height: 150rpx;
}

.memo-back:active {
  opacity: 0.7;
}
