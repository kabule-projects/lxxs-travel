.home {
  position: relative;
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: rgb(248, 236, 196);
}

.home-page-bg {
  position: absolute;
  left: 0;
  top: 57%;
  width: 100%;
  z-index: 0;
  transform: translateY(-50%);
  pointer-events: none;
}

.home-overlay {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ── 顶栏（布局同商店）；top 由内联样式给定，避让右上角胶囊 ── */
.home-hud {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.hud-side {
  width: 168rpx;
  flex-shrink: 0;
}

.hud-side--left {
  visibility: hidden;
}

.hud-side--right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.hud-center {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  padding-right: 40%;
}

/* 计数框：整张贴图（框 + 星星 icon 已画进图），数字叠加在贴图右侧留白区 */
.currency-pill {
  position: relative;
  flex-shrink: 0;
}

/* 两个框宽度分别设置（高度由 widthFix 按贴图比例自适应） */
.currency-pill--star {
  width: 255rpx;
  margin-bottom: 5rpx;
}

.currency-pill--rice {
  width: 178rpx;
}

.currency-pill__bg {
  width: 100%;
  display: block;
}

.currency-pill__num {
  position: absolute;
  top: 50%;
  right: 35rpx;
  transform: translateY(-50%);
  font-size: 32rpx;
  font-weight: 900;
  color: #634f3cff;
  line-height: 1;
}

/* ── 家具热区 ── */
.hotspot {
  position: absolute;
  z-index: 12;
}

.hotspot--disabled {
  pointer-events: none;
}

.hotspot-showcase {
  left: 2%;
  top: 14%;
  width: 22%;
  height: 38%;
}

.hotspot-wardrobe {
  right: 2%;
  top: 22%;
  width: 26%;
  height: 34%;
}

.hotspot-diary {
  left: 30%;
  top: 52%;
  width: 22%;
  height: 18%;
}

/* ── 底栏；bottom 由内联样式给定（安全区上沿 + 间距） ── */
.home-footer {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.footer-left,
.footer-right {
  pointer-events: auto;
}

.footer-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20rpx;
}

.btn-prepare-img {
  width: 280rpx;
  display: block;
}
