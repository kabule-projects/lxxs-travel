.home {
  position: relative;
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: rgb(248, 236, 196);
}

.home-page-bg {
  position: absolute;
  left: 0;
  top: 57%;
  width: 100%;
  z-index: 0;
  transform: translateY(-50%);
  pointer-events: none;
}

.home-overlay {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 窗户：叠在背景上，位置/大小按屏幕百分比（相对 .home-overlay 即视口） */
.home-window {
  position: absolute;
  right: 28%;
  top: 24.5%;
  width: 16.5%;
  z-index: 5;
}

/* 标包装饰：盖在窗户(z5)之上，无交互；位置/大小按屏幕百分比调 */
.home-biao-bag {
  position: absolute;
  left: 42.5%;
  top: 31.5%;
  width: 19%;
  z-index: 6;
  pointer-events: none;
}

/* ── 顶栏（布局同商店）；top 由内联样式给定，避让右上角胶囊 ── */
.home-hud {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.hud-side {
  width: 168rpx;
  flex-shrink: 0;
}

.hud-side--left {
  visibility: hidden;
}

.hud-side--right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.hud-center {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  padding-right: 40%;
}

/* 计数框：基础样式 + 数字定位在 app.wxss 全局定义，此处只管两个框各自的宽度 */
.currency-pill--star {
  width: 255rpx;
  margin-bottom: 5rpx;
}

.currency-pill--rice {
  width: 178rpx;
}

/* ── 家具热区 ── */
.hotspot {
  position: absolute;
  z-index: 12;
}

.hotspot--disabled {
  pointer-events: none;
}

.hotspot-showcase {
  left: 5%;
  top: 32%;
  width: 36%;
  height: 22%;
}

.hotspot-wardrobe {
  right: 2%;
  top: 35%;
  width: 32%;
  height: 20%;
}

.hotspot-diary {
  left: 26%;
  top: 55.5%;
  width: 20%;
  height: 5%;
}

/* ── 底栏；bottom 由内联样式给定（安全区上沿 + 间距） ── */
.home-footer {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.footer-left,
.footer-right {
  pointer-events: auto;
}

.footer-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20rpx;
}

.btn-prepare-img {
  width: 280rpx;
  display: block;
}
