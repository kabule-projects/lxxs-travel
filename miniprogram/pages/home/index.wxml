<view class="home">
  <!-- 整页静态背景：宽度铺满屏幕，垂直居中（上下溢出裁剪） -->
  <image class="home-page-bg" src="{{assets.room}}" mode="widthFix" />

  <view class="home-overlay">
    <!-- 窗户：叠在背景上，点击进入屋顶；位置/大小按屏幕百分比调 -->
    <image
      class="home-window"
      src="{{assets.window}}"
      mode="widthFix"
      bindtap="onTapWindow"
    />
    <!-- 标包装饰：纯装饰贴图，盖在窗户图层之上，无交互 -->
    <image class="home-biao-bag" src="{{assets.biaoBag}}" mode="widthFix" />

    <!-- 顶栏：双货币（同商店）+ 背包 / 设置；top 内联，避让右上角胶囊 -->
    <view class="home-hud" style="top: {{hudTop}}px">
      <view class="hud-side hud-side--left" aria-hidden="true"></view>
      <view class="hud-center">
        <view class="currency-pill currency-pill--star">
          <image class="currency-pill__bg" src="{{assets.pillStar}}" mode="widthFix" />
          <text class="currency-pill__num">{{stars}}</text>
        </view>
        <view class="currency-pill currency-pill--rice">
          <image class="currency-pill__bg" src="{{assets.pillRice}}" mode="widthFix" />
          <text class="currency-pill__num">{{riceStars}}</text>
        </view>
      </view>
      <view class="hud-side hud-side--right">
        <nav-icon src="{{assets.iconBag}}" label="背包" size="sm" bind:tap="onTapBag" />
        <nav-icon src="{{assets.iconGrid}}" label="设置" size="sm" bind:tap="onTapSettings" />
      </view>
    </view>

    <!-- 家具热区：展示柜 / 日记；衣柜 Phase2 再开 -->
    <view
      class="hotspot hotspot-showcase"
      bindtap="onTapShowcase"
      aria-label="展示柜"
    ></view>
    <view
      class="hotspot hotspot-wardrobe hotspot--disabled"
      aria-label="衣柜（暂未开放）"
      aria-disabled="true"
    ></view>
    <view
      class="hotspot hotspot-diary"
      bindtap="onTapDiary"
      aria-label="日记"
    ></view>

    <trip-banner visible="{{showTravelBanner}}" mode="{{travelBannerMode}}" />

    <!-- 底栏：准备 + 商店 / 扭蛋；bottom 内联，贴安全区上沿 -->
    <view class="home-footer" style="bottom: {{footerBottom}}px">
      <view class="footer-left">
        <image
          wx:if="{{assets.btnPrepare}}"
          class="btn-prepare-img"
          src="{{assets.btnPrepare}}"
          mode="widthFix"
          bindtap="onTapPrepare"
        />
        <nav-icon
          wx:else
          src="{{assets.iconPrepare}}"
          label="准备"
          size="lg"
          bind:tap="onTapPrepare"
        />
      </view>
      <view class="footer-right">
        <nav-icon src="{{assets.iconShop}}" label="商店" size="md" bind:tap="onTapShop" />
        <nav-icon src="{{assets.iconGacha}}" label="扭蛋" size="md" bind:tap="onTapGacha" />
      </view>
    </view>
  </view>

  <bag-modal
    visible="{{showBag}}"
    bind:close="onCloseBag"
    bind:depart="onBagDepart"
  />
  <settings-modal visible="{{showSettings}}" bind:close="onCloseSettings" />
</view>
