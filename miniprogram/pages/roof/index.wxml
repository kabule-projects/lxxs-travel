<view class="roof" style="padding-top: {{safeTop}}px; padding-bottom: {{safeBottom}}px">
  <image class="layer layer-sky" src="{{skySrc}}" mode="aspectFill" />
  <image class="layer layer-rooftop" src="{{rooftopSrc}}" mode="aspectFill" />

  <!-- 星星：单一列表，空中倒计时 / 落下后堆在鸽子左下 -->
  <view class="sky-layer">
    <star-item
      wx:for="{{starItems}}"
      wx:key="id"
      starId="{{item.id}}"
      kind="{{item.status === 'pending' ? 'pending' : 'dropped'}}"
      type="{{item.type}}"
      src="{{item.type === 'rice' ? assets.starRice : assets.star}}"
      left="{{item.displayLeft}}"
      top="{{item.displayTop}}"
      rotate="{{item.status === 'pending' ? 0 : item.rotate}}"
      zIndex="{{item.status === 'pending' ? 4 : 5}}"
      remainText="{{item.remainText}}"
      bind:collect="onCollectStar"
    />
  </view>

  <!-- 鸽子 + 魔术帽（静态装饰 + 信箱入口） -->
  <view class="pigeon-spot" bindtap="onTapPigeon">
    <image class="magic-hat-img" src="{{assets.magicHat}}" mode="aspectFit" />
    <image
      wx:if="{{pigeonState !== 'away' || flyAway}}"
      class="pigeon-img {{pigeonState === 'mail' ? 'pigeon-img--mail' : ''}} {{flyAway ? 'pigeon-img--fly' : ''}}"
      src="{{pigeonState === 'mail' && !flyAway ? assets.pigeonMail : assets.pigeon}}"
      mode="aspectFit"
    />
    <image
      wx:if="{{pigeonState === 'mail' && !flyAway}}"
      class="mail-tip-img"
      src="{{assets.mailTip}}"
      mode="widthFix"
    />
    <text class="plus-one" wx:if="{{plusOneVisible}}" wx:key="plusOneSeq">+1</text>
  </view>

  <trip-banner visible="{{showTravelBanner}}" text="{{travelBannerText}}" />

  <!-- 顶栏：双货币 + 物品 / 设置 -->
  <view class="roof-hud">
    <view class="hud-side hud-side--left" aria-hidden="true"></view>
    <view class="hud-center">
      <view class="currency-pill">
        <image class="currency-icon" src="{{assets.iconStar}}" mode="aspectFit" />
        <text class="currency-num">{{stars}}</text>
      </view>
      <view class="currency-pill">
        <image class="currency-icon" src="{{assets.iconRiceStar}}" mode="aspectFit" />
        <text class="currency-num">{{riceStars}}</text>
      </view>
    </view>
    <view class="hud-side hud-side--right">
      <nav-icon src="{{assets.iconItems}}" label="物品" size="sm" bind:tap="onTapItems" />
      <nav-icon src="{{assets.iconGrid}}" label="设置" size="sm" bind:tap="onTapSettings" />
    </view>
  </view>

  <!-- 底栏：准备 + 商店 / 小屋 -->
  <view class="roof-footer">
    <view class="footer-left">
      <image
        wx:if="{{assets.btnPrepare}}"
        class="btn-prepare-img"
        src="{{assets.btnPrepare}}"
        mode="widthFix"
        bindtap="onTapPrepare"
      />
      <nav-icon
        wx:else
        src="{{assets.iconPrepare}}"
        label="准备"
        size="lg"
        bind:tap="onTapPrepare"
      />
    </view>
    <view class="footer-right">
      <nav-icon src="{{assets.iconShop}}" label="商店" size="md" bind:tap="onTapShop" />
      <nav-icon src="{{assets.iconHome}}" label="小屋" size="md" bind:tap="onTapHome" />
    </view>
  </view>

  <bag-modal
    visible="{{showBag}}"
    bind:close="onCloseBag"
    bind:depart="onBagDepart"
  />
  <inventory-picker
    visible="{{showInv}}"
    lock-tab=""
    bind:close="onCloseInv"
    bind:select="onSelectInv"
  />
  <mail-box-modal
    visible="{{showMailbox}}"
    items="{{mailItems}}"
    mail-cap="{{mailCap}}"
    bind:close="onCloseMailbox"
    bind:itemschange="onMailItemsChange"
    bind:claim="onClaimMail"
  />
  <settings-modal visible="{{showSettings}}" bind:close="onCloseSettings" />
</view>
