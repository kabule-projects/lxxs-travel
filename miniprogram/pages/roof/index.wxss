.roof {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #2a1f4e;
}

.layer {
  position: absolute;
  left: 0;
  width: 100%;
  pointer-events: none;
}

/* 宽度适配 + 垂直居中：高度由 widthFix 按图片比例自适应，上下溢出裁掉 */
.layer-bg {
  top: 50%;
  z-index: 0;
  transform: translateY(-50%);
}

.sky-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
}

/* ── 屋顶底部角色装饰（纵向位置按屏幕高度百分比，随屏比漂移小） ── */
.roof-characters {
  position: absolute;
  left: 0;
  right: 42%;
  bottom: 23%;
  z-index: 5;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: none;
}

.char-shen {
  width: 200rpx;
}

.char-biao {
  width: 110rpx;
  margin-left: -70rpx;
}

.char-mi {
  position: relative;
  z-index: 1;
  width: 90rpx;
  margin-right: -80rpx;
}

/* ── 顶栏（同主页/商店）；top 由内联样式给定，避让右上角胶囊 ── */
.roof-hud {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.hud-side {
  width: 168rpx;
  flex-shrink: 0;
}

.hud-side--left {
  visibility: hidden;
}

.hud-side--right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.hud-center {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  padding-right: 40%;
}

/* 计数框：整张贴图（框 + 星星 icon 已画进图），数字叠加在贴图右侧留白区 */
.currency-pill {
  position: relative;
  flex-shrink: 0;
}

/* 两个框宽度分别设置（高度由 widthFix 按贴图比例自适应） */
.currency-pill--star {
  width: 240rpx;
}

.currency-pill--rice {
  width: 180rpx;
}

.currency-pill__bg {
  width: 100%;
  display: block;
}

.currency-pill__num {
  position: absolute;
  top: 50%;
  right: 20rpx;
  transform: translateY(-50%);
  font-size: 28rpx;
  font-weight: 700;
  color: #3a2410;
  line-height: 1;
}

/* ── 鸽子（屋顶右侧，星星堆在其左下） ── */
.pigeon-spot {
  position: absolute;
  right: 5%;
  bottom: 24%;
  z-index: 6;
  width: 160rpx;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.magic-hat-img {
  width: 108rpx;
  height: 76rpx;
  margin-top: auto;
}

.pigeon-img {
  position: absolute;
  bottom: 62rpx;
  width: 96rpx;
  height: 96rpx;
  transition: transform 0.9s ease-in, opacity 0.9s ease-in;
}

.pigeon-img--mail {
  filter: drop-shadow(0 0 8rpx rgba(232, 146, 58, 0.55));
}

.pigeon-img--fly {
  transform: translate(120rpx, -220rpx) scale(0.4);
  opacity: 0;
}

.mail-tip-img {
  position: absolute;
  top: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
}

.plus-one {
  position: absolute;
  left: -36rpx;
  bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffe27a;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.45);
  animation: plus-pop 0.25s ease-out;
  pointer-events: none;
}

@keyframes plus-pop {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ── 底栏；bottom 由内联样式给定（安全区上沿 + 间距） ── */
.roof-footer {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.footer-left,
.footer-right {
  pointer-events: auto;
}

.footer-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20rpx;
}

.btn-prepare-img {
  width: 240rpx;
  /* 单独调出发键左右位置（在 footer 左边距基础上叠加），不影响右下角商店/小屋 */
  margin-left: -20rpx;
  display: block;
}
