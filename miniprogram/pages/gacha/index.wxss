.gacha {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 24rpx;
  padding-right: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f8efd8;
}

/* 整页背景（地毯已画进背景，勿再叠地毯层） */
.gacha-page-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* ── 顶栏（布局同 home）；top 由内联样式给定，避让右上角胶囊 ── */
.gacha-hud {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  box-sizing: border-box;
}

/* 左右两侧等宽，保证中间货币框水平居中；返回与设置同为 nav-icon size="sm"，高度一致 */
.hud-side {
  width: 168rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.hud-side--left {
  justify-content: flex-start;
}

.hud-side--right {
  justify-content: flex-end;
}

.hud-center {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

/* 计数框：基础样式 + 数字定位在 app.wxss 全局定义，此处只管两个框各自的宽度 */
.currency-pill--star {
  width: 255rpx;
  margin-bottom: 5rpx;
}

.currency-pill--rice {
  width: 178rpx;
}

/* 扭蛋机：宽度铺满屏幕，垂直居中；热区百分比相对机器图自身 */
.machine-wrap {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
}

.machine-img {
  width: 100%;
  display: block;
}

/* 机器图上画着的"抽1次/抽五次"按钮 → 透明热区 */
.machine-btn {
  position: absolute;
  width: 15%;
  height: 11%;
  z-index: 3;
}

.machine-btn--1 {
  left: 47%;
  top: 57%;
}

.machine-btn--5 {
  left: 66%;
  top: 57%;
}

/* 底栏；bottom 由内联样式给定（安全区上沿 + 间距） */
.gacha-foot {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 78rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.exchange-banner-img {
  width: 82.7%;
}

/* 奖品图鉴按钮：右对齐；大小改 width，水平位置改 margin-right，
   与横幅间距改 .gacha-foot 的 gap，整体高低改内联 bottom（footBottom） */
.prizes-btn-img {
  width: 30%;
  align-self: flex-end;
  margin-right: 1%;
}

.spin-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
}

.spin-hint {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 120rpx;
  z-index: 51;
  text-align: center;
  font-size: 24rpx;
  color: rgba(74, 55, 40, 0.75);
}
