.gacha {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 24rpx;
  padding-right: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f8efd8;
}

/* 整页背景（地毯已画进背景，勿再叠地毯层） */
.gacha-page-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.gacha-hud {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
}

.hud-center {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.currency-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 120rpx;
  height: 52rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  border: 3rpx solid #5a3a22;
  background: #fffaf3;
}

.currency-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.currency-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #3a2410;
  line-height: 1;
}

.machine-wrap {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 0;
  width: 66%;
  margin: 0 auto;
}

.machine-img {
  width: 100%;
}

/* 机器图上画着的"抽1次/抽五次"按钮 → 透明热区 */
.machine-btn {
  position: absolute;
  width: 22%;
  height: 10%;
  z-index: 3;
}

.machine-btn--1 {
  left: 43.8%;
  top: 60.6%;
}

.machine-btn--5 {
  left: 62.9%;
  top: 60.6%;
}

.gacha--spin .machine-img {
  animation: dome-shake 0.35s ease-in-out infinite alternate;
}

@keyframes dome-shake {
  from {
    transform: rotate(-1deg);
  }
  to {
    transform: rotate(1deg);
  }
}

.gacha-foot {
  position: relative;
  z-index: 2;
  padding: 16rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.exchange-banner-img {
  width: 82.7%;
}

.prizes-btn-img {
  width: 36%;
}

.spin-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
}

.spin-hint {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 120rpx;
  z-index: 51;
  text-align: center;
  font-size: 24rpx;
  color: rgba(74, 55, 40, 0.75);
}
