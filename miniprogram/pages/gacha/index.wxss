.gacha {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 24rpx;
  padding-right: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f8efd8;
}

/* 整页背景（地毯已画进背景，勿再叠地毯层） */
.gacha-page-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.gacha-hud {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
}

.gacha-hud .star-counter {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.machine-wrap {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 0;
  width: 100%;
  max-width: 620rpx;
  margin: 0 auto;
}

.machine-img {
  width: 72%;
  max-height: 52vh;
}

.gacha--spin .machine-img {
  animation: dome-shake 0.35s ease-in-out infinite alternate;
}

@keyframes dome-shake {
  from {
    transform: rotate(-1deg);
  }
  to {
    transform: rotate(1deg);
  }
}

.machine-controls {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.count-btn-img {
  height: 64rpx;
  opacity: 0.65;
}

.count-btn-img--on {
  opacity: 1;
}

.spin-btn-img {
  width: 200rpx;
}

.gacha-foot {
  position: relative;
  z-index: 2;
  padding: 16rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.exchange-banner-img {
  width: 100%;
  max-width: 620rpx;
}

.prizes-btn-img {
  width: 240rpx;
}

.spin-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
}

.spin-hint {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 120rpx;
  z-index: 51;
  text-align: center;
  font-size: 24rpx;
  color: rgba(74, 55, 40, 0.75);
}
