<view class="gacha">
  <image class="gacha-page-bg" src="{{assets.pageBg}}" mode="aspectFill" />

  <!-- 顶栏：双货币贴图框 + 设置（布局同 home）；top 内联，避让右上角胶囊 -->
  <view class="gacha-hud" style="top: {{hudTop}}px">
    <view class="hud-side hud-side--left">
      <nav-icon src="{{assets.iconBack}}" label="返回" size="sm" bind:tap="onTapBack" />
    </view>
    <view class="hud-center">
      <view class="currency-pill currency-pill--star">
        <image class="currency-pill__bg" src="{{assets.pillStar}}" mode="widthFix" />
        <text class="currency-pill__num">{{stars}}</text>
      </view>
      <view class="currency-pill currency-pill--rice">
        <image class="currency-pill__bg" src="{{assets.pillRice}}" mode="widthFix" />
        <text class="currency-pill__num">{{riceStars}}</text>
      </view>
    </view>
    <view class="hud-side hud-side--right">
      <nav-icon src="{{assets.iconGrid}}" label="设置" size="sm" bind:tap="onTapSettings" />
    </view>
  </view>

  <!-- 扭蛋机：宽度铺满屏幕、垂直居中。静态图常驻；抽奖时动图叠在同一盒子里先隐藏加载，
       bindload 加载完成后同一帧隐藏静态图、显示动图，避免两张图都不显示的空档 -->
  <view class="machine-wrap">
    <image
      class="machine-img {{spinning && animReady ? 'machine-img--hide' : ''}}"
      src="{{assets.machine}}"
      mode="aspectFit"
    />
    <image
      wx:if="{{spinning}}"
      class="machine-img machine-img--anim {{animReady ? 'machine-img--anim-on' : ''}}"
      src="{{animSrc}}"
      mode="aspectFit"
      bindload="onAnimLoad"
    />
    <view class="machine-btn machine-btn--1" data-count="1" catchtap="onTapDraw" />
    <view class="machine-btn machine-btn--5" data-count="5" catchtap="onTapDraw" />
  </view>

  <!-- 底栏：兑换横幅 + 奖品图鉴按钮；bottom 内联，贴安全区上沿 -->
  <view class="gacha-foot" style="bottom: {{footBottom}}px">
    <image class="exchange-banner-img" src="{{assets.exchangeBanner}}" mode="widthFix" />
    <image
      class="prizes-btn-img"
      src="{{assets.btnPrizes}}"
      mode="widthFix"
      catchtap="onTapPrizes"
    />
  </view>

  <view wx:if="{{spinning}}" class="spin-overlay" catchtap="onTapSkipSpin"></view>
  <view wx:if="{{spinning}}" class="spin-hint">点击屏幕跳过动画</view>

  <gacha-result
    visible="{{showResult}}"
    results="{{drawResults}}"
    icon-star="{{assets.iconStar}}"
    bind:close="onCloseResult"
    bind:confirm="onConfirmResult"
  />

  <gacha-prizes
    visible="{{showPrizes}}"
    items="{{catalog}}"
    bind:close="onClosePrizes"
  />

  <settings-modal visible="{{showSettings}}" bind:close="onCloseSettings" />
</view>
