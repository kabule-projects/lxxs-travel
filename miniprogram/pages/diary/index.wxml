<view class="diary">
  <!-- diary-bg（frame+notebook 合并图层）宽撑满屏幕、垂直居中；页内元素均按其边缘百分比定位 -->
  <view class="diary-frame">
    <image class="diary-frame-bg" src="{{assets.diaryBg}}" mode="scaleToFill" />

    <!-- 标签页：底边贴笔记本顶边，激活标签更高；类型数 = 图鉴中实际出现的类型（最多 4 个） -->
    <view class="notebook-tabs" wx:if="{{tabs.length > 0}}">
      <view
        wx:for="{{tabs}}"
        wx:key="type"
        class="tab-item"
        data-type="{{item.type}}"
        bindtap="onTapTab"
      >
        <image style="position: relative; left: 0rpx; top: -97rpx"
          class="tab-img {{activeTab === item.type ? 'tab-img--on' : ''}}"
          src="{{activeTab === item.type ? assets.tabActive : assets.tab}}"
          mode="aspectFit"
        />
      </view>
    </view>

    <!-- 网格：左右翻页，每页 3 列 × 4 行 = 12 个 -->
    <swiper
      class="grid-swiper"
      style="left: {{swiperLeft}}px; top: {{swiperTop}}px; width: {{swiperW}}px; height: {{swiperH}}px"
      current="{{currentPage}}"
      bindchange="onSwiperChange"
      circular="{{false}}"
      duration="300"
    >
      <swiper-item wx:for="{{pages}}" wx:key="index">
        <view class="grid">
          <view
            wx:for="{{item}}"
            wx:for-item="slot"
            wx:key="key"
            class="grid-cell {{slot.entryIndex === 0 ? 'guide-anchor-postcard' : ''}}"
            data-index="{{slot.entryIndex}}"
            bindtap="onTapEntry"
          >
            <!-- 空格底图（手绘边框方块） -->
            <image class="grid-cell-bg" src="{{assets.gridCell}}" mode="aspectFill" />
            <image
              wx:if="{{slot.imageThumb}}"
              class="grid-thumb"
              src="{{slot.imageThumb}}"
              mode="aspectFill"
            />
            <image
              wx:elif="{{slot.imageFull}}"
              class="grid-thumb"
              src="{{slot.imageFull}}"
              mode="aspectFill"
            />
          </view>
        </view>
      </swiper-item>
    </swiper>

    <!-- 翻页提示：有翻页需求时显示，点击任意位置关闭 -->
    <view wx:if="{{showHint}}" class="diary-hint-mask" bindtap="onDismissHint">
      <image class="diary-hint" src="{{assets.hint}}" mode="widthFix" catchtap="onDismissHint" />
    </view>

    <!-- 返回按钮：左下角 -->
    <image style="position: absolute; left: 46rpx; top: 1412rpx"
      class="diary-back guide-anchor-diary-back"
      src="{{assets.iconBack}}"
      mode="aspectFit"
      bindtap="onTapBack"
    />

    <!-- 备忘录入口：内页天气图标行右侧，尺寸与图标一致 -->
    <image
      class="memo-btn guide-anchor-memo"
      style="left: {{memoBtnLeft}}px; top: {{memoBtnTop}}px; width: {{memoBtnW}}px; height: {{memoBtnH}}px"
      src="{{assets.memoBtn}}"
      mode="aspectFit"
      bindtap="onTapMemo"
    />
  </view>

  <!-- 明信片大图弹层（与 mail 共用组件）：信封点击展开信件 -->
  <postcard-zoom
    wx:if="{{zoomVisible && !letterVisible}}"
    image="{{zoomImage}}"
    title="{{zoomTitle}}"
    envelope="{{assets.envelope}}"
    bind:close="onCloseZoom"
    bind:envelope="onTapEnvelope"
  />

  <diary-letter
    visible="{{letterVisible}}"
    date-text="{{letterDate}}"
    story="{{letterStory}}"
    title="{{zoomTitle}}"
    bind:close="onCloseLetter"
  />

  <!-- 新手指引强制遮罩（弹窗显示期间进入无遮罩模式，只显示文字泡） -->
  <guide-overlay
    visible="{{guideVisible}}"
    holes="{{guideHoles}}"
    hit-rect="{{guideHit}}"
    text="{{guideText}}"
    no-mask="{{guideNoMask}}"
    bind:blocked="onGuideBlocked"
  />

  <!-- diary-envelope 步骤：独立气泡文字（不渲染 guide-overlay，用户可自由点击弹窗）。
       定位在明信片大图下方，箭头朝右上指向右下角信封 -->
  <view wx:if="{{guideBubbleVisible}}" class="diary-guide-bubble" style="{{guideBubbleStyle}}">
    <view class="diary-guide-bubble-arrow"></view>
    <view class="diary-guide-bubble-text">{{guideBubbleText}}</view>
  </view>
</view>
