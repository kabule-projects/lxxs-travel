<view class="diary">
  <image class="diary-frame-bg" src="{{assets.frame}}" mode="aspectFill" />
  <view class="diary-frame">
    <view class="diary-hud" style="padding-top: {{safeTop}}px">
      <nav-icon src="{{assets.iconBack}}" label="返回" size="sm" bind:tap="onTapBack" />
      <nav-icon src="{{assets.iconGrid}}" label="设置" size="sm" bind:tap="onTapSettings" />
    </view>

    <view class="notebook">
      <!-- 笔记本底已含书脊 / 天气 / 吉祥物 -->
      <image class="notebook-bg" src="{{assets.notebook}}" mode="aspectFill" />

      <view class="notebook-tabs">
        <image class="tab-img tab-img--active" src="{{assets.tabActive}}" mode="aspectFit" />
        <image class="tab-img" src="{{assets.tab}}" mode="aspectFit" />
        <image class="tab-img" src="{{assets.tab}}" mode="aspectFit" />
        <image class="tab-img" src="{{assets.tab}}" mode="aspectFit" />
      </view>

      <scroll-view class="grid-scroll" scroll-y>
        <view class="grid">
          <view
            wx:for="{{gridSlots}}"
            wx:key="key"
            class="grid-cell"
            data-index="{{item.entryIndex}}"
            bindtap="onTapEntry"
          >
            <!-- 半透明浅紫底格（对齐设计稿） -->
            <view class="grid-cell-plate"></view>
            <image
              wx:if="{{item.imageThumb}}"
              class="grid-thumb"
              src="{{item.imageThumb}}"
              mode="aspectFill"
            />
            <image
              wx:elif="{{item.imageFull}}"
              class="grid-thumb"
              src="{{item.imageFull}}"
              mode="aspectFill"
            />
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="zoom-mask" wx:if="{{zoomVisible && !letterVisible}}" catchtap="onCloseZoom">
    <view class="zoom-card" catchtap="onStopZoom">
      <image
        wx:if="{{zoomImage}}"
        class="zoom-image"
        src="{{zoomImage}}"
        mode="aspectFit"
      />
      <view wx:else class="zoom-ph">{{zoomTitle[0] || '?'}}</view>
      <view class="envelope" catchtap="onTapEnvelope">
        <image class="envelope-img" src="{{assets.envelope}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <diary-letter
    visible="{{letterVisible}}"
    date-text="{{letterDate}}"
    story="{{letterStory}}"
    title="{{zoomTitle}}"
    bind:close="onCloseLetter"
  />

  <settings-modal visible="{{showSettings}}" bind:close="onCloseSettings" />
</view>
