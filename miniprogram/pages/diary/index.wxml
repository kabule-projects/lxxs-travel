<view class="diary">
  <!-- diary-bg（frame+notebook 合并图层）宽撑满屏幕、垂直居中；页内元素均按其边缘百分比定位 -->
  <view class="diary-frame">
    <image class="diary-frame-bg" src="{{assets.diaryBg}}" mode="scaleToFill" />

    <view class="diary-hud" style="top: {{hudTop}}px">
      <nav-icon src="{{assets.iconBack}}" label="返回" size="sm" bind:tap="onTapBack" />
    </view>

    <!-- 标签页：底边贴笔记本顶边，激活标签更高；类型数 = 图鉴中实际出现的类型（最多 4 个） -->
    <view class="notebook-tabs" wx:if="{{tabs.length > 0}}">
      <view
        wx:for="{{tabs}}"
        wx:key="type"
        class="tab-item"
        data-type="{{item.type}}"
        bindtap="onTapTab"
      >
        <image
          class="tab-img"
          src="{{activeTab === item.type ? assets.tabActive : assets.tab}}"
          mode="widthFix"
        />
        <text class="tab-label">{{item.label}}</text>
      </view>
    </view>

    <scroll-view class="grid-scroll" scroll-y>
      <view class="grid">
        <view
          wx:for="{{gridSlots}}"
          wx:key="key"
          class="grid-cell"
          data-index="{{item.entryIndex}}"
          bindtap="onTapEntry"
        >
          <!-- 空格底图（手绘边框方块） -->
          <image class="grid-cell-bg" src="{{assets.gridCell}}" mode="aspectFill" />
          <image
            wx:if="{{item.imageThumb}}"
            class="grid-thumb"
            src="{{item.imageThumb}}"
            mode="aspectFill"
          />
          <image
            wx:elif="{{item.imageFull}}"
            class="grid-thumb"
            src="{{item.imageFull}}"
            mode="aspectFill"
          />
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="zoom-mask" wx:if="{{zoomVisible && !letterVisible}}" catchtap="onCloseZoom">
    <view class="zoom-card" catchtap="onStopZoom">
      <image
        wx:if="{{zoomImage}}"
        class="zoom-image"
        src="{{zoomImage}}"
        mode="aspectFit"
      />
      <view wx:else class="zoom-ph">{{zoomTitle[0] || '?'}}</view>
      <view class="envelope" catchtap="onTapEnvelope">
        <image class="envelope-img" src="{{assets.envelope}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <diary-letter
    visible="{{letterVisible}}"
    date-text="{{letterDate}}"
    story="{{letterStory}}"
    title="{{zoomTitle}}"
    bind:close="onCloseLetter"
  />
</view>
