<view class="diary">
  <!-- diary-bg（frame+notebook 合并图层）宽撑满屏幕、垂直居中；页内元素均按其边缘百分比定位 -->
  <view class="diary-frame">
    <image class="diary-frame-bg" src="{{assets.diaryBg}}" mode="scaleToFill" />

    <!-- 标签页：底边贴笔记本顶边，激活标签更高；类型数 = 图鉴中实际出现的类型（最多 4 个） -->
    <view class="notebook-tabs" wx:if="{{tabs.length > 0}}">
      <view
        wx:for="{{tabs}}"
        wx:key="type"
        class="tab-item"
        data-type="{{item.type}}"
        bindtap="onTapTab"
      >
        <image
          class="tab-img"
          src="{{activeTab === item.type ? assets.tabActive : assets.tab}}"
          mode="widthFix"
        />
      </view>
    </view>

    <!-- 网格：左右翻页，每页 3 列 × 4 行 = 12 个 -->
    <swiper
      class="grid-swiper"
      style="left: {{swiperLeft}}px; top: {{swiperTop}}px; width: {{swiperW}}px; height: {{swiperH}}px"
      current="{{currentPage}}"
      bindchange="onSwiperChange"
      circular="{{false}}"
      duration="300"
    >
      <swiper-item wx:for="{{pages}}" wx:key="index">
        <view class="grid">
          <view
            wx:for="{{item}}"
            wx:for-item="slot"
            wx:key="key"
            class="grid-cell"
            data-index="{{slot.entryIndex}}"
            bindtap="onTapEntry"
          >
            <!-- 空格底图（手绘边框方块） -->
            <image class="grid-cell-bg" src="{{assets.gridCell}}" mode="aspectFill" />
            <image
              wx:if="{{slot.imageThumb}}"
              class="grid-thumb"
              src="{{slot.imageThumb}}"
              mode="aspectFill"
            />
            <image
              wx:elif="{{slot.imageFull}}"
              class="grid-thumb"
              src="{{slot.imageFull}}"
              mode="aspectFill"
            />
          </view>
        </view>
      </swiper-item>
    </swiper>

    <!-- 翻页提示：有翻页需求时显示，点击任意位置关闭 -->
    <view wx:if="{{showHint}}" class="diary-hint-mask" bindtap="onDismissHint">
      <image class="diary-hint" src="{{assets.hint}}" mode="widthFix" catchtap="onDismissHint" />
    </view>

    <!-- 返回按钮：左下角 -->
    <image
      class="diary-back"
      src="{{assets.iconBack}}"
      mode="aspectFit"
      bindtap="onTapBack"
    />
  </view>

  <view class="zoom-mask" wx:if="{{zoomVisible && !letterVisible}}" catchtap="onCloseZoom">
    <view class="zoom-card" catchtap="onStopZoom">
      <image wx:if="{{zoomImage}}"
        class="zoom-image"
        src="{{zoomImage}}"
        mode="aspectFit"
        bindload="onZoomImageLoad"
      />
      <view wx:else class="zoom-ph">{{zoomTitle[0] || '?'}}</view>
      <image
        class="zoom-envelope"
        style="right: {{envelopeRight}}%; bottom: {{envelopeBottom}}%"
        src="{{assets.envelope}}"
        mode="aspectFit"
        catchtap="onTapEnvelope"
      />
    </view>
  </view>

  <diary-letter
    visible="{{letterVisible}}"
    date-text="{{letterDate}}"
    story="{{letterStory}}"
    title="{{zoomTitle}}"
    bind:close="onCloseLetter"
  />
</view>
