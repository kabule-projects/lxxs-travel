/* frame 宽撑满屏幕、垂直居中；高于屏幕时上下对称裁切 */
.diary {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #5a4088;
}

.diary-frame {
  position: relative;
  width: 100%;
  aspect-ratio: 2002 / 4330;
  flex-shrink: 0;
}

.diary-frame-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 返回按钮：左下角；位置改 left/bottom，大小改 width/height（切图 149×149 方形，
   不设 height 时 image 默认高 225px，会盖住左下格子；bottom 6% 对齐原视觉位置） */
.diary-back {
  position: absolute;
  left: 13%;
  bottom: 6%;
  width: 150rpx;
  height: 150rpx;
  z-index: 5;
}

/* 标签页：底边贴笔记本顶边（flex-end 对齐），激活标签更高 */
.notebook-tabs {
  position: absolute;
  left: 11%;
  top: 11.4%;
  width: 53%;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  gap: 2%;
}

.tab-item {
  position: relative;
  width: 25%;
  flex-shrink: 0;
}

/* 固定宽高按切图比例（tab 268×122 / tab-active 269×264，宽≈原 tab-item 25%×53% 屏宽）：
   加载前不塌缩；激活标签更高由 --on 定高体现。tab 悬在页面深色底上，用浅色半透明占位 */
.tab-img {
  width: 100rpx;
  height: 46rpx;
  display: block;
  background: rgba(255, 255, 255, 0.08);
}

.tab-img--on {
  height: 98rpx;
}

/* 明信片网格 swiper：左右翻页。
   left/top/width/height 全部由 JS 按格子大小推算后内联设置，
   swiper 是原生组件，CSS width 无法让内部 item 缩放，必须用内联 px */
.grid-swiper {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
}

.grid-swiper swiper-item {
  width: 100%;
  height: 100%;
}

/* 备忘录入口按钮：位置/尺寸由 JS 按 frame 百分比内联，与天气图标同大对齐 */
.memo-btn {
  position: absolute;
  z-index: 3;
}
.memo-btn:active {
  opacity: 0.7;
}

/* 3 列固定，行高由格子的 aspect-ratio:1/1 自动撑开；
   最后一行不足 3 个时，第三列位置自动留空 */
.grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 48rpx;
}

.grid-cell {
  position: relative;
  width: 100%;
  aspect-ratio: 1/1;
  box-sizing: border-box;
  left: -1rpx;
  top: -1rpx;
}

/* 空格底图：手绘边框方块切图 */
.grid-cell-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 102%;
  height: 102%;
  z-index: 5;
  background: rgba(0, 0, 0, 0.06);
}

/* 明信片切图叠在空格底图上 */
.grid-thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: rgba(0, 0, 0, 0.06);
}

/* 翻页提示遮罩：全屏黑色 70% 不透明，点击任意位置关闭 */
.diary-hint-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 翻页提示贴图：水平垂直居中，大小改 width；
   显式定高 = 屏宽 60%（450rpx）× 切图高宽比（hint 965×420），widthFix 加载前后同高不抖动 */
.diary-hint {
  width: 60%;
  height: 196rpx;
}

/* diary-envelope 步骤：独立气泡文字（无遮罩，浮于弹窗上方）。
   left/top 由 JS 按大图卡片位置内联给定（卡片下方、右端对齐信封列） */
.diary-guide-bubble {
  position: fixed;
  z-index: 2000;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  pointer-events: none; /* 气泡不拦截点击 */
}

.diary-guide-bubble-text {
  width: 440rpx;
  box-sizing: border-box;
  background: #fff;
  border: 4rpx solid #d4c8e8;
  border-radius: 32rpx;
  padding: 18rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: bold;
  color: #4a3870;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

/* 箭头在文字上方、靠右；向上的三角旋转 45° 后朝右上，指向明信片右下角信封 */
.diary-guide-bubble-arrow {
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 20rpx solid #fff;
  margin-right: 40rpx;
  margin-bottom: -10rpx;
  transform: rotate(45deg);
}


.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6a5a88;
}
