/* frame 宽撑满屏幕、垂直居中；高于屏幕时上下对称裁切 */
.diary {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #5a4088;
}

.diary-frame {
  position: relative;
  width: 100%;
  aspect-ratio: 2002 / 4330;
  flex-shrink: 0;
}

.diary-frame-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 顶栏：top 由胶囊规避派生（px，内联），左右按 frame 白区边缘百分比 */
.diary-hud {
  position: absolute;
  left: 4%;
  right: 3%;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 标签页：底边贴笔记本顶边（flex-end 对齐），激活标签更高 */
.notebook-tabs {
  position: absolute;
  left: 11%;
  top: 11.4%;
  width: 53%;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  gap: 2%;
}

.tab-item {
  position: relative;
  width: 25%;
  flex-shrink: 0;
}

.tab-img {
  width: 100%;
  display: block;
}

/* 类型名叠加在贴图标签上 */
.tab-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 10%;
  text-align: center;
  font-size: 20rpx;
  color: #6b5136;
  pointer-events: none;
}

/* 明信片网格：四边按 frame 边缘百分比 */
.grid-scroll {
  position: absolute;
  left: 14%;
  padding-right: 29%;
  top: 29%;
  bottom: 4.5%;
  z-index: 2;
  box-sizing: border-box;
}

/* 固定每行 3 个：1fr 等宽列，间距从列宽自动扣除，无需手算 */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 48rpx;
}

.grid-cell {
  position: relative;
  width: 100%;
  aspect-ratio: 1/1;
  box-sizing: border-box;
}

/* 空格底图：手绘边框方块切图 */
.grid-cell-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 明信片切图叠在空格底图上 */
.grid-thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}


.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6a5a88;
}

.zoom-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.zoom-card {
  position: relative;
  width: 75vw;
  max-width: 620rpx;
  aspect-ratio: 3 / 4;
  border-radius: 16rpx;
  border: 6rpx solid #5a4088;
  background: #d8d0f0;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
}

.zoom-image {
  width: 100%;
  height: 100%;
}

.zoom-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  font-weight: 700;
  color: #5a4088;
}

.envelope {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #3a5088;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.25);
}

.envelope-img {
  width: 56rpx;
  height: 56rpx;
}
