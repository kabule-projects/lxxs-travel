/* frame 宽撑满屏幕、垂直居中；高于屏幕时上下对称裁切 */
.diary {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #5a4088;
}

.diary-frame {
  position: relative;
  width: 100%;
  aspect-ratio: 2002 / 4330;
  flex-shrink: 0;
}

.diary-frame-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 返回按钮：左下角；位置改 left/bottom，大小改 width */
.diary-back {
  position: absolute;
  left: 13%;
  bottom: -3%;
  width: 150rpx;
  z-index: 5;
}

/* 标签页：底边贴笔记本顶边（flex-end 对齐），激活标签更高 */
.notebook-tabs {
  position: absolute;
  left: 11%;
  top: 11.4%;
  width: 53%;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  gap: 2%;
}

.tab-item {
  position: relative;
  width: 25%;
  flex-shrink: 0;
}

/* 固定宽高按切图比例（tab 268×122 / tab-active 269×264，宽≈原 tab-item 25%×53% 屏宽）：
   加载前不塌缩；激活标签更高由 --on 定高体现。tab 悬在页面深色底上，用浅色半透明占位 */
.tab-img {
  width: 100rpx;
  height: 46rpx;
  display: block;
  background: rgba(255, 255, 255, 0.08);
}

.tab-img--on {
  height: 98rpx;
}

/* 明信片网格 swiper：左右翻页。
   left/top/width/height 全部由 JS 按格子大小推算后内联设置，
   swiper 是原生组件，CSS width 无法让内部 item 缩放，必须用内联 px */
.grid-swiper {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
}

.grid-swiper swiper-item {
  width: 100%;
  height: 100%;
}

/* 3 列固定，行高由格子的 aspect-ratio:1/1 自动撑开；
   最后一行不足 3 个时，第三列位置自动留空 */
.grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 48rpx;
}

.grid-cell {
  position: relative;
  width: 100%;
  aspect-ratio: 1/1;
  box-sizing: border-box;
  left: -1rpx;
  top: -1rpx;
}

/* 空格底图：手绘边框方块切图 */
.grid-cell-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 102%;
  height: 102%;
  z-index: 5;
  background: rgba(0, 0, 0, 0.06);
}

/* 明信片切图叠在空格底图上 */
.grid-thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: rgba(0, 0, 0, 0.06);
}

/* 翻页提示遮罩：全屏黑色 70% 不透明，点击任意位置关闭 */
.diary-hint-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 翻页提示贴图：水平垂直居中，大小改 width */
.diary-hint {
  width: 60%;
}


.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6a5a88;
}
