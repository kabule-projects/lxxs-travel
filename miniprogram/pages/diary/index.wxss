.diary {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 20rpx 32rpx;
  overflow: hidden;
  background: #5a4088;
}

.diary-frame-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.diary-frame {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - 56rpx);
  overflow: hidden;
}

.diary-hud {
  position: relative;
  z-index: 5;
  padding: 12rpx 16rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notebook {
  position: relative;
  margin: 16rpx 24rpx 28rpx 32rpx;
  min-height: calc(100vh - 200rpx);
  overflow: hidden;
  border-radius: 16rpx;
}

.notebook-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.notebook-tabs {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 8rpx;
  padding: 20rpx 24rpx 0 36rpx;
}

.tab-img {
  width: 120rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.grid-scroll {
  position: relative;
  z-index: 2;
  height: calc(100vh - 300rpx);
  padding: 24rpx 20rpx 32rpx 36rpx;
  box-sizing: border-box;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.grid-cell {
  position: relative;
  width: calc((100% - 40rpx) / 3);
  aspect-ratio: 1;
  box-sizing: border-box;
}

/* 设计稿空格：浅紫半透明底 + 1px / 50% 紫边 */
.grid-cell-plate {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  box-sizing: border-box;
  background: rgba(186, 178, 224, 0.45);
  border: 1px solid rgba(90, 64, 136, 0.5);
  border-radius: 4rpx;
}

/* 明信片切图叠在半透明底上，外围同样 1px / 50% 紫边 */
.grid-thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  box-sizing: border-box;
  border: 1px solid rgba(90, 64, 136, 0.5);
  border-radius: 4rpx;
}


.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6a5a88;
}

.zoom-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.zoom-card {
  position: relative;
  width: 75vw;
  max-width: 620rpx;
  aspect-ratio: 3 / 4;
  border-radius: 16rpx;
  border: 6rpx solid #5a4088;
  background: #d8d0f0;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
}

.zoom-image {
  width: 100%;
  height: 100%;
}

.zoom-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  font-weight: 700;
  color: #5a4088;
}

.envelope {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #3a5088;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.25);
}

.envelope-img {
  width: 56rpx;
  height: 56rpx;
}
