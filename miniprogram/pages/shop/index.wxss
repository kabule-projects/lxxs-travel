.shop {
  position: relative;
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.shop-page-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 4%;
  z-index: 0;
}

/* 背景副本：叠在主背景下方，从顶部 0 开始填充主背景 top:4% 留出的空隙 */
.shop-page-bg--back {
  top: 0;
  z-index: -1;
}

.shop-overlay {
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

/* ── 顶栏（布局同 home/gacha）；top 由内联样式给定，避让右上角胶囊 ── */
.shop-hud {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  box-sizing: border-box;
}

/* 左右两侧等宽，保证中间货币框水平居中；返回与设置同为 nav-icon size="sm"，高度一致 */
.hud-side {
  width: 168rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.hud-side--left {
  justify-content: flex-start;
}

.hud-side--right {
  justify-content: flex-end;
}

.hud-center {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

/* 计数框：基础样式 + 数字定位在 app.wxss 全局定义，此处只管两个框各自的宽度 */
.currency-pill--star {
  width: 255rpx;
  margin-bottom: 5rpx;
}

.currency-pill--rice {
  width: 178rpx;
}

.tabs {
  white-space: nowrap;
  height: 48rpx;
  padding: 4rpx 20rpx 0;
  box-sizing: border-box;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  padding: 0 20rpx;
  margin-right: 10rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #6b5344;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(90, 58, 34, 0.25);
}

.tab--on {
  color: #fffaf3;
  background: #6b4a2e;
  border-color: #5a3a22;
}

/*
 * 展示柜玻璃区域（对齐 page-bg 中柜台）
 * 设计稿 1320×2868：left≈9% right≈9% top≈36% height≈30%
 */
.cabinet-layer {
  position: absolute;
  left: 9%;
  right: 9%;
  top: 42%;
  height: 26%;
  z-index: 3;
}

.goods-swiper {
  width: 100%;
  height: 100%;
}

.shelf-page {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 0 2%;
  box-sizing: border-box;
}

.shelf-row {
  flex: 1;
  display: flex;
  align-items: flex-end;
  min-height: 0;
}

.shelf-slots {
  width: 100%;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
}

.shelf-slot {
  position: relative;
  width: 30%;
  height: 100%;
  max-height: 176rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.shelf-slot--empty {
  pointer-events: none;
}

.shelf-slot--on .slot-icon {
  transform: translateY(-6rpx) scale(1.06);
}

.shelf-slot--sold {
  opacity: 0.45;
}

.slot-icon {
  position: relative;
  z-index: 1;
  width: 112rpx;
  height: 112rpx;
  margin-bottom: -10rpx;
  transition: transform 0.15s ease;
}

.slot-tag {
  position: relative;
  z-index: 4;
  width: 96rpx;
  height: 52rpx;
}

.slot-tag-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.slot-tag-content {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding-bottom: 4rpx;
  box-sizing: border-box;
}

.tag-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #3a2410;
  line-height: 1;
}

.tag-star {
  width: 30rpx;
  height: 30rpx;
}

.page-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -28rpx;
  text-align: center;
  font-size: 20rpx;
  color: #8a7463;
}

/*
 * 底部简介区（对齐 page-bg 中信纸位置）
 * bottom 由内联样式给定（安全区上沿 + 间距）
 */
.footer-layer {
  position: absolute;
  left: 5%;
  right: 5%;
  height: 26%;
  z-index: 4;
}

/* 木纹背景板：垫在商品名/介绍文本下方，覆盖 desc-text 区域 */
.wood-board {
  position: absolute;
  left: -2%;
  top: 8%;
  width: 82%;
  z-index: 1;
  pointer-events: none;
}

.desc-text {
  position: absolute;
  left: 9%;
  right: 29%;
  top: 15%;
  bottom: 12%;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
}

.desc-title {
  font-size: 120%;
  font-weight: 700;
  color: #3f2e22;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.desc-body {
  flex: 1;
  margin-top: 8rpx;
  font-size: 100%;
  color: #6b5344;
  line-height: 1.8;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.side-btns {
  position: absolute;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20rpx;
}

/* 侧键大小同 home/roof 底部 nav-icon md：96rpx */
.side-btn {
  width: 96rpx;
  height: 96rpx;
}

.buy-btn-img {
  position: absolute;
  right: 19.5%;
  bottom: 0%;
  width: 200rpx;
  z-index: 3;
}
