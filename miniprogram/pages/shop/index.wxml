<view class="shop">
  <!-- 背景副本：叠在主背景下方 -->
  <image class="shop-page-bg shop-page-bg--back" src="{{assets.pageBg}}" mode="aspectFill" />
  <!-- 整页静态背景（条纹/店主/柜台/木纹/信纸装饰等） -->
  <image class="shop-page-bg" src="{{assets.pageBg}}" mode="aspectFill" />

  <view class="shop-overlay">
    <!-- 顶栏：返回 + 双货币贴图框 + 设置（布局同 home/gacha）；top 内联，避让右上角胶囊 -->
    <view class="shop-hud" style="top: {{hudTop}}px">
      <view class="hud-side hud-side--left">
        <nav-icon src="{{assets.iconBack}}" label="返回" size="sm" bind:tap="onTapBack" />
      </view>
      <view class="hud-center">
        <view class="currency-pill currency-pill--star">
          <image class="currency-pill__bg" src="{{assets.pillStar}}" mode="widthFix" />
          <text class="currency-pill__num">{{stars}}</text>
        </view>
        <view class="currency-pill currency-pill--rice">
          <image class="currency-pill__bg" src="{{assets.pillRice}}" mode="widthFix" />
          <text class="currency-pill__num">{{riceStars}}</text>
        </view>
      </view>
      <view class="hud-side hud-side--right">
        <nav-icon src="{{assets.iconGrid}}" label="设置" size="sm" bind:tap="onTapSettings" />
      </view>
    </view>

    <!-- 展示柜：仅物品 icon + 价签；位置/尺寸内联 px（cabinetStyle），真机不依赖百分比高度 -->
    <view class="cabinet-layer" style="{{cabinetStyle}}">
      <swiper
        class="goods-swiper"
        current="{{pageIndex}}"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{pages}}" wx:for-item="page" wx:key="index">
          <view class="shelf-page">
            <view
              wx:for="{{page.shelves}}"
              wx:for-item="shelf"
              wx:for-index="si"
              wx:key="si"
              class="shelf-row shelf-row--{{si}}"
            >
              <view class="shelf-slots">
                <view
                  wx:for="{{shelf.slots}}"
                  wx:for-item="goods"
                  wx:for-index="ci"
                  wx:key="ci"
                  class="shelf-slot {{goods.empty ? 'shelf-slot--empty' : ''}} {{selectedId === goods.id ? 'shelf-slot--on' : ''}} {{goods.boughtToday ? 'shelf-slot--sold' : ''}}"
                  data-id="{{goods.id}}"
                  bindtap="onTapItem"
                >
                  <block wx:if="{{!goods.empty}}">
                    <image
                      wx:if="{{goods.icon}}"
                      class="slot-icon"
                      src="{{goods.icon}}"
                      mode="aspectFit"
                    />
                    <view class="slot-tag">
                      <image class="slot-tag-bg" src="{{assets.priceTag}}" mode="widthFix" />
                      <view class="slot-tag-content">
                        <text class="tag-price">{{goods.price}}</text>
                      </view>
                    </view>
                  </block>
                </view>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="page-dots" wx:if="{{totalPages > 1}}">{{pageIndex + 1}} / {{totalPages}}</view>
    </view>

    <!-- 底部：木纹背景板 + 简介文字 + 购买按钮 -->
    <view class="footer-layer" style="bottom: {{footBottom}}px">
      <image class="wood-board" src="{{assets.woodBoard}}" mode="widthFix" />

      <view class="desc-text">
        <view class="desc-title">{{selectedName || '选择一件商品'}}</view>
        <view class="desc-body">{{selectedDesc || '点货架上的物品查看简介'}}</view>
      </view>

      <image
        class="buy-btn-img"
        src="{{buyEnabled ? assets.btnBuy : assets.btnBuyDisabled}}"
        mode="widthFix"
        bindtap="onTapBuy"
      />
    </view>

    <!-- 右侧底部侧键：背包 / 扭蛋（大小/位置同 home/roof 底部按钮：96rpx、距右 32rpx、纵向间距 20rpx） -->
    <view class="side-btns" style="right: 32rpx; bottom: {{footBottom}}px">
      <image class="side-btn" src="{{assets.sideBtnBag}}" mode="aspectFit" bindtap="onTapBag" />
      <image class="side-btn" src="{{assets.sideBtnGacha}}" mode="aspectFit" bindtap="onTapGacha" />
    </view>
  </view>

  <inventory-picker
    visible="{{showInv}}"
    lock-tab=""
    bind:close="onCloseInv"
  />
  <settings-modal visible="{{showSettings}}" bind:close="onCloseSettings" />
</view>
