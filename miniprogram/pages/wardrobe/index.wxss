.page {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: #f5e8c8;
}

/* 舞台承接原根容器的纵向布局与内边距（绝对定位的舞台按 padding box 定位，
   内边距必须放在舞台而非外层容器上） */
.fit-stage--wardrobe {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 24rpx;
}

.hud {
  align-self: flex-start;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding-right: 24rpx;
}

/* 显式定高 = 宽 480rpx × 切图高宽比（empty 300×300 方形），widthFix 加载前后同高不抖动 */
.empty-img {
  width: 480rpx;
  height: 480rpx;
  margin-top: 120rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #6b5344;
  text-align: center;
}
