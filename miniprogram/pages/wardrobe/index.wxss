.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5e8c8;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
}

.hud {
  align-self: flex-start;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding-right: 24rpx;
}

.empty-img {
  width: 480rpx;
  margin-top: 120rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #6b5344;
  text-align: center;
}
