.gate {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a1520;
  padding: 48rpx;
  box-sizing: border-box;
}
.card {
  background: rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}
.title { display: block; font-size: 36rpx; color: #fff; margin-bottom: 24rpx; }
.desc { display: block; font-size: 28rpx; color: rgba(255,255,255,0.75); line-height: 1.6; }
.meta { display: block; margin-top: 32rpx; font-size: 22rpx; color: rgba(255,255,255,0.45); }
