<view class="scene">
  <!-- loading 专属背景 -->
  <image
    class="layer layer-bg"
    src="{{bgSrc}}"
    mode="widthFix"
    bindload="onLayerLoaded"
    binderror="onLayerError"
  />

  <!-- 进入按钮：常驻同位同尺寸；加载中显示 disabled 贴图，完成后切常态贴图 -->
  <view class="enter-zone" style="padding-top: {{safeTop}}px">
    <view class="enter-hit" bindtap="onEnterGame">
      <image
        class="enter-img {{canEnter ? '' : 'enter-img--wait'}}"
        src="{{canEnter ? btnEnterSrc : btnEnterDisabledSrc}}"
        mode="widthFix"
        show-menu-by-longpress="{{false}}"
      />
    </view>
  </view>

  <loading-frame
    progress="{{progress}}"
    tip="{{canEnter ? '' : tip}}"
    safeBottom="{{safeBottom}}"
    showBar="{{true}}"
  />
</view>
