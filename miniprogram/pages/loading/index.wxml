<view class="scene">
  <!-- 设计舞台：与背景图渲染盒一致（宽铺满、按切图比例定高、垂直居中）；
       短宽屏整体等比缩小到贴合屏高，按钮/进度条仍锚定背景图同一位置（见 utils/fit.ts） -->
  <view class="fit-stage" style="{{stageStyle}}">
    <!-- loading 专属背景 -->
    <image
      class="layer layer-bg"
      src="{{bgSrc}}"
      mode="widthFix"
      bindload="onLayerLoaded"
      binderror="onLayerError"
    />

    <!-- 加载中：进度条占着按钮的位置（同位同高），完成后消失 -->
    <view class="loading-slot" wx:if="{{!canEnter}}">
      <loading-bar progress="{{progress}}" thumb-src="{{barThumbSrc}}" />
    </view>

    <!-- 加载完成：按钮在同一位置出现（相对背景图 top 75.5%） -->
    <view class="enter-zone" wx:if="{{canEnter}}">
      <view class="enter-hit" bindtap="onEnterGame">
        <image
          class="enter-img"
          src="{{btnEnterSrc}}"
          mode="widthFix"
          show-menu-by-longpress="{{false}}"
        />
      </view>
    </view>

    <!-- 底部仅保留提示文字；进度条已上移到按钮位。
         放在舞台内（而非舞台外）：内联 safeBottom 是舞台坐标，随舞台一起缩放 -->
    <loading-frame
      progress="{{progress}}"
      tip="{{entering ? '正在准备小屋…' : (canEnter ? '' : tip)}}"
      safeBottom="{{safeBottom}}"
      showBar="{{false}}"
    />
  </view>
</view>
