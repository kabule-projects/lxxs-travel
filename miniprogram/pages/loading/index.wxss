.scene {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #2a1f4e;
}

.layer {
  position: absolute;
  left: 0;
  width: 100%;
}

/* 宽度适配 + 垂直居中：高度按切图比例显式定（loading-bg 828×1792，750rpx 宽 → 1623rpx），
   widthFix 加载前后同高不抖动，上下溢出裁掉 */
.layer-bg {
  top: 50%;
  z-index: 0;
  height: 1623rpx;
  transform: translateY(-50%);
}

/* 进度条占位：与 .enter-zone 完全同位（top 75.5%），加载中占着按钮的位置 */
.loading-slot {
  position: absolute;
  left: 0;
  right: 0;
  top: 75.5%;
  z-index: 4;
  display: flex;
  justify-content: center;
  box-sizing: border-box;
  animation: zone-fade-in 0.3s ease-out;
}

.enter-zone {
  position: absolute;
  left: 0;
  right: 0;
  top: 75.5%;
  z-index: 4;
  display: flex;
  justify-content: center;
  box-sizing: border-box;
  animation: zone-fade-in 0.3s ease-out;
}

@keyframes zone-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.enter-hit {
  width: 250rpx;
  max-width: 40vw;
}

/* 显式定高 = 热区宽 250rpx × 切图高宽比（btn-enter 403×163），widthFix 加载前后同高不抖动 */
.enter-img {
  width: 100%;
  height: 101rpx;
  display: block;
  transition: opacity 0.3s, transform 0.2s;
}

.enter-hit:active .enter-img {
  transform: scale(0.98);
}
