.scene {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #efe8d3ff;
}

/* 设计舞台（.fit-stage，见 app.wxss）与背景图渲染盒完全一致：
   宽 100%、按切图比例显式定高、垂直居中，上下溢出由 .scene 裁掉。
   按钮/进度条以舞台为坐标系按百分比定位，屏幕比例变化时永远锚定背景图同一位置 */

.layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
}

.layer-bg {
  z-index: 0;
  height: 100%;
}

/* 进度条占位：与 .enter-zone 完全同位（相对背景图 top 75.5%），加载中占着按钮的位置 */
.loading-slot {
  position: absolute;
  left: 0;
  right: 0;
  top: 81%;
  z-index: 4;
  display: flex;
  justify-content: center;
  box-sizing: border-box;
  animation: zone-fade-in 0.3s ease-out;
}

.enter-zone {
  position: absolute;
  left: 0;
  right: 0;
  top: 81%;
  z-index: 4;
  display: flex;
  justify-content: center;
  box-sizing: border-box;
  animation: zone-fade-in 0.3s ease-out;
}

@keyframes zone-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.enter-hit {
  width: 250rpx;
  max-width: 40vw;
}

/* 显式定高 = 热区宽 250rpx × 切图高宽比（btn-enter 403×163），widthFix 加载前后同高不抖动 */
.enter-img {
  width: 100%;
  height: 101rpx;
  display: block;
  transition: opacity 0.3s, transform 0.2s;
}

.enter-hit:active .enter-img {
  transform: scale(0.98);
}
