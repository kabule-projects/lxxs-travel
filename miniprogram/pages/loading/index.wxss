.scene {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #2a1f4e;
}

.layer {
  position: absolute;
  left: 0;
  width: 100%;
}

/* 宽度适配 + 垂直居中：高度由 widthFix 按图片比例自适应，上下溢出裁掉 */
.layer-bg {
  top: 50%;
  z-index: 0;
  transform: translateY(-50%);
}

/* ── 底部角色装饰 ── */
.roof-characters {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 23%;
  z-index: 5;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: none;
}

.char-shen {
  width: 200rpx;
}

.char-biao {
  width: 110rpx;
  margin-left: -70rpx;
}

.char-mi {
  position: relative;
  z-index: 1;
  width: 90rpx;
  margin-right: -80rpx;
}

/* ── 鸽子 + 魔术帽 ── */
.pigeon-spot {
  position: absolute;
  right: 5%;
  bottom: 24%;
  z-index: 8;
  width: 180rpx;
  height: 180rpx;
  pointer-events: none;
}

.magic-hat-img,
.pigeon-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* ── 星星层 ── */
.sky-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  pointer-events: none;
}

/* ── loading logo ── */
.loading-logo {
  position: absolute;
  left: 50%;
  top: 23%;
  transform: translateX(-50%);
  width: 570rpx;
  z-index: 3;
}

.enter-zone {
  position: absolute;
  left: 0;
  right: 0;
  top: 37%;
  z-index: 4;
  display: flex;
  justify-content: center;
  box-sizing: border-box;
}

.enter-hit {
  width: 250rpx;
  max-width: 40vw;
}

.enter-img {
  width: 100%;
  display: block;
  transition: opacity 0.3s, transform 0.2s;
}

.enter-img--wait {
  opacity: 0.55;
}

.enter-hit:active .enter-img:not(.enter-img--wait) {
  transform: scale(0.98);
}
