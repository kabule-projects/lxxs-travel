.star-item {
  position: absolute;
  width: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.star-item--pending {
  width: 120rpx;
}

.star-item--pending::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 28rpx;
  width: 108rpx;
  height: 108rpx;
  margin-left: -54rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  box-shadow: 0 0 24rpx rgba(255, 255, 255, 0.45);
  z-index: 0;
  pointer-events: none;
}

.star-item--pending .star-item__img,
.star-item--pending .star-item__fallback {
  position: relative;
  z-index: 1;
}

.star-item--dropped {
  width: 72rpx;
}

.star-item__img {
  width: 100%;
  display: block;
  filter: drop-shadow(0 0 12rpx rgba(255, 255, 255, 0.7));
}

.star-item__fallback {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 56rpx;
  color: #ffd24a;
  text-shadow: 0 0 16rpx #fff;
}

.star-item--rice .star-item__fallback {
  color: #ffe9a8;
}

.star-item__remain {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #fff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
  white-space: nowrap;
}
