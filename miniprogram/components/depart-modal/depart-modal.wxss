.depart-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(20, 12, 28, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.depart-panel {
  position: relative;
  width: 620rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.depart-panel-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.depart-title {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #4a3728;
  text-align: center;
}

.depart-desc {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #6b5340;
  text-align: center;
}

.depart-desc {
  position: relative;
  z-index: 1;
}

.depart-actions {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
  display: flex;
  gap: 24rpx;
}

.depart-btn-img {
  flex: 1;
  height: 80rpx;
}
