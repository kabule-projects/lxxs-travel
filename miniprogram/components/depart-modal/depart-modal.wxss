.depart-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(20, 12, 28, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.depart-panel {
  position: relative;
  width: 620rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 28rpx;
  background: #fff4d1;
  border: 4rpx solid #d4a574;
}

.depart-panel-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.25;
  pointer-events: none;
}

.depart-title {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #4a3728;
  text-align: center;
}

.depart-desc {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #6b5340;
  text-align: center;
}

.depart-actions {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.depart-btn-img {
  flex: 1;
  max-height: 88rpx;
}

.depart-btn-fallback {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.depart-btn-fallback--wait {
  background: #f0dcc0;
  color: #6b5340;
}

.depart-btn-fallback--ok {
  background: #c47a3a;
  color: #fff8ee;
}
