.star-counter {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 24rpx 8rpx 16rpx;
  background: rgba(255, 248, 230, 0.92);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.star-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.star-icon-fallback {
  font-size: 36rpx;
  color: #f5a623;
  line-height: 1;
}

.star-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #4a3728;
  min-width: 40rpx;
}
