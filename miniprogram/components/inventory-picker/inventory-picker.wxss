.inv-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(12, 8, 6, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
}

.inv-panel {
  position: relative;
  width: 640rpx;
  max-height: 78vh;
  padding: 28rpx 24rpx 36rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #f4ead8;
  border: 6rpx dashed #c48a4a;
}

.inv-close {
  position: absolute;
  top: -18rpx;
  right: -18rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e8923a;
  color: #fff;
  font-size: 40rpx;
  line-height: 58rpx;
  text-align: center;
  z-index: 2;
}

.inv-tabs {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
  min-height: 80rpx;
}

.inv-tabs--locked {
  justify-content: flex-start;
}

/* 未选中较矮；选中增高一截（切图本身也应更高） */
.inv-tab {
  height: 56rpx;
  max-width: 48%;
  flex-shrink: 0;
}

.inv-tab--on {
  height: 80rpx;
}

.inv-list {
  position: relative;
  z-index: 1;
  max-height: 62vh;
  min-height: 360rpx;
}

.inv-card {
  position: relative;
  margin-bottom: 16rpx;
  min-height: 140rpx;
  overflow: hidden;
}

.inv-card-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.inv-card-body {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 18rpx;
  box-sizing: border-box;
}

.inv-icon {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.inv-icon image {
  width: 100%;
  height: 100%;
}

.inv-count {
  position: absolute;
  right: 4rpx;
  bottom: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #e07a2a;
}

.inv-meta {
  flex: 1;
  min-width: 0;
}

.inv-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #c47a2e;
}

.inv-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4a3728;
  line-height: 1.4;
}

.inv-empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #8a7463;
  font-size: 26rpx;
}
