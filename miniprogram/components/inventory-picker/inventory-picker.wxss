.inv-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(12, 8, 6, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 面板按 inventory/panel 切图（1118×1481）等比：宽度占屏 85.4%，内容区按切图相对坐标定位 */
.inv-panel {
  position: relative;
  width: 85.4%;
}

.inv-panel-bg {
  display: block;
  width: 100%;
}

.inv-content {
  position: absolute;
  left: 5.5%;
  right: 5.5%;
  top: 8.5%;
  bottom: 5.5%;
  display: flex;
  flex-direction: column;
}

.inv-close {
  position: absolute;
  top: 2%;
  right: 3%;
  z-index: 2;
}

.inv-tabs {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
  min-height: 80rpx;
}

.inv-tabs--locked {
  justify-content: flex-start;
}

/* 未选中较矮；选中增高一截（切图本身也应更高） */
.inv-tab {
  height: 56rpx;
  max-width: 48%;
  flex-shrink: 0;
}

.inv-tab--on {
  height: 80rpx;
}

.inv-list {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
}

.inv-card {
  position: relative;
  margin-bottom: 16rpx;
  min-height: 140rpx;
  overflow: hidden;
}

.inv-card-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.inv-card-body {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 18rpx;
  box-sizing: border-box;
}

.inv-icon {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.inv-icon image {
  width: 100%;
  height: 100%;
}

.inv-count {
  position: absolute;
  right: 4rpx;
  bottom: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #e07a2a;
}

.inv-meta {
  flex: 1;
  min-width: 0;
}

.inv-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #c47a2e;
}

.inv-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4a3728;
  line-height: 1.4;
}

.inv-empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #8a7463;
  font-size: 26rpx;
}
