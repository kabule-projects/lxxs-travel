.inv-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(12, 8, 6, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 面板按 inventory/panel 切图（1118×1481）等比：宽度占屏 85.4%，内容区按切图相对坐标定位 */
.inv-panel {
  position: relative;
  width: 85.4%;
}

.inv-panel-bg {
  display: block;
  width: 100%;
}

/* 内容区仅为定位上下文：tabs 与 list 各自绝对定位，位置互不影响 */
.inv-content {
  position: absolute;
  left: 5.5%;
  right: 5.5%;
  top: 8.5%;
  bottom: 5.5%;
}

.inv-close {
  position: absolute;
  top: -8%;
  right: 2%;
  z-index: 2;
}

.inv-tabs {
  position: absolute;
  left: 5%;
  right: 0;
  top: -20.6%;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
}

.inv-tabs--locked {
  justify-content: flex-start;
}

/* widthFix：宽度直接设定，高度随切图比例；选中态更高由切图本身体现 */
.inv-tab {
  width: 110rpx;
  flex-shrink: 0;
}

/* 列表：独立的顶部边界，与 tab 高度/位置无关 */
.inv-list {
  position: absolute;
  left: -5%;
  right: 0;
  top: 80rpx;
  bottom: 0;
}

.inv-card {
  position: relative;
  margin-bottom: 16rpx;
  min-height: 150rpx;
  overflow: hidden;
}

.inv-card-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.inv-card-body {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 18rpx;
  box-sizing: border-box;
}

.inv-icon {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.inv-icon image {
  width: 100%;
  height: 100%;
}

.inv-count {
  position: absolute;
  right: 4rpx;
  bottom: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #e07a2a;
}

.inv-meta {
  flex: 1;
  min-width: 0;
}

.inv-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #c47a2e;
}

.inv-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4a3728;
  line-height: 1.4;
}

.inv-empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #8a7463;
  font-size: 26rpx;
}
