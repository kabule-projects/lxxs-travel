.loading-frame {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

.tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}
