.mbox-root {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.mbox-backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 面板按 mailbox/deco-2 切图（1681×2340）等比：宽度占屏 85.4%，
   标题与提示文案已画进切图，内容区避开顶部文案与底部小鸡/卷角装饰 */
.mbox-panel {
  position: relative;
  width: 85.4%;
}

.mbox-panel-bg {
  display: block;
  width: 100%;
}

.mbox-content {
  position: absolute;
  left: 5%;
  right: 5%;
  top: 17%;
  bottom: 11%;
}

.mbox-close {
  position: absolute;
  top: 1.5%;
  right: 2%;
  z-index: 2;
}

.mbox-list {
  position: relative;
  z-index: 1;
  height: 100%;
}

/* 行背景为 mailbox/panel 棕色条（1453×318），行高由切图比例决定 */
.mbox-row {
  position: relative;
  margin-bottom: 3%;
}

/* 行高按切图比例固定（1453×318，行宽 = 屏宽 750×85.4%×90% ≈ 576rpx → 高约 126rpx），加载前不塌缩 */
.mbox-row-bg {
  display: block;
  width: 100%;
  height: 126rpx;
  background: rgba(0, 0, 0, 0.06);
}

.mbox-row-body {
  position: absolute;
  left: 3%;
  right: 3%;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 3%;
}

.mbox-row--new {
  border-radius: 16rpx;
  box-shadow: inset 0 0 0 4rpx #f0d878;
}

.mbox-thumb {
  width: 16%;
  height: 74%;
  border-radius: 12rpx;
  background: #c47a3a;
  flex-shrink: 0;
  overflow: hidden;
}

.mbox-thumb image {
  width: 100%;
  height: 100%;
}

.mbox-thumb-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff4d1;
}

.mbox-name {
  flex: 1;
  color: #f3e6cf;
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mbox-row--new .mbox-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #fffaf3;
}

.mbox-empty {
  padding: 60rpx 20rpx;
  text-align: center;
  color: #8a7463;
  font-size: 26rpx;
}
