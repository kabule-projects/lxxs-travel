.mbox-root {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.mbox-backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mbox-panel {
  position: relative;
  width: 620rpx;
  max-height: 78vh;
  padding: 40rpx 32rpx 56rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.mbox-panel-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.mbox-close {
  position: absolute;
  top: -22rpx;
  right: -18rpx;
  z-index: 2;
}

.mbox-title-img {
  position: relative;
  z-index: 1;
  width: 280rpx;
  margin: 0 auto;
  display: block;
}

.mbox-hint {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: #c47a3a;
  padding: 0 8rpx;
}

.mbox-list {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  max-height: 52vh;
}

.mbox-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #5a3a22;
  border: 3rpx solid transparent;
  box-sizing: border-box;
}

.mbox-row--new {
  border-color: #f0d878;
  border-width: 5rpx;
  padding: 16rpx 20rpx;
}

.mbox-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #c47a3a;
  flex-shrink: 0;
  overflow: hidden;
}

.mbox-thumb image {
  width: 100%;
  height: 100%;
}

.mbox-thumb-ph {
  width: 100%;
  height: 100%;
}

.mbox-name {
  flex: 1;
  color: #f3e6cf;
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mbox-row--new .mbox-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #fffaf3;
}

.mbox-empty {
  padding: 60rpx 20rpx;
  text-align: center;
  color: #8a7463;
  font-size: 26rpx;
}

.mbox-deco {
  position: absolute;
  bottom: 16rpx;
  width: 28rpx;
  height: 28rpx;
  z-index: 1;
  opacity: 0.35;
}

.mbox-deco--l {
  left: 24rpx;
}

.mbox-deco--r {
  right: 32rpx;
}

/* 叠在信箱上的黑色遮罩 + 明信片放大（同日记） */
.mbox-detail-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mbox-zoom-card {
  position: relative;
  width: 75vw;
  max-width: 620rpx;
  aspect-ratio: 3 / 4;
  border-radius: 16rpx;
  border: 6rpx solid #5a4088;
  background: #d8d0f0;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
}

.mbox-zoom-image {
  width: 100%;
  height: 100%;
}

.mbox-zoom-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  font-weight: 700;
  color: #5a4088;
}

.mbox-envelope {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #3a5088;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.25);
}

.mbox-envelope-img {
  width: 56rpx;
  height: 56rpx;
}

.mbox-envelope-badge-img {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 32rpx;
  height: 32rpx;
}
