<view class="mbox-root" wx:if="{{visible}}">
  <view class="mbox-backdrop">
    <view class="mbox-panel" catchtap="onStop">
      <image class="mbox-panel-bg" src="{{assets.panel}}" mode="widthFix" />
      <icon-close
        class="mbox-close"
        src="{{assets.iconClose}}"
        size="{{64}}"
        bind:tap="onClose"
      />
      <image class="mbox-title-img" src="{{assets.title}}" mode="widthFix" />
      <view class="mbox-hint">鸽子最多帮忙保存{{mailCap}}封信，超过{{mailCap}}封，旧的信件会自动已读哦</view>

      <scroll-view class="mbox-list" scroll-y>
        <view
          wx:for="{{listItems}}"
          wx:key="instanceId"
          class="mbox-row {{item.isNew ? 'mbox-row--new' : ''}}"
          data-index="{{index}}"
          catchtap="onTapRow"
        >
          <view class="mbox-thumb">
            <image
              wx:if="{{item.imageThumb}}"
              src="{{item.imageThumb}}"
              mode="aspectFill"
            />
            <view wx:else class="mbox-thumb-ph">{{item.title[0] || '?'}}</view>
          </view>
          <text class="mbox-name">{{item.title || '明信片的名字'}}</text>
        </view>
        <view wx:if="{{!listItems.length}}" class="mbox-empty">暂时没有未读信件</view>
      </scroll-view>
    </view>
  </view>

  <view
    class="mbox-detail-mask"
    wx:if="{{detailVisible && !letterVisible}}"
    catchtap="onCloseDetail"
  >
    <view class="mbox-zoom-card" catchtap="onStop">
      <image
        wx:if="{{zoomImage}}"
        class="mbox-zoom-image"
        src="{{zoomImage}}"
        mode="aspectFit"
      />
      <view wx:else class="mbox-zoom-ph">{{zoomTitle[0] || '?'}}</view>
      <view class="mbox-envelope" catchtap="onTapEnvelope">
        <image class="mbox-envelope-img" src="{{assets.envelope}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <diary-letter
    visible="{{letterVisible}}"
    date-text="{{letterDate}}"
    story="{{letterStory}}"
    title="{{zoomTitle}}"
    auto-claim="{{true}}"
    bind:close="onCloseLetter"
    bind:claim="onClaim"
  />
</view>
