<view class="mbox-root" wx:if="{{visible}}">
  <view class="mbox-backdrop">
    <view class="mbox-panel" catchtap="onStop">
      <image class="mbox-panel-bg" src="{{assets.panel}}" mode="widthFix" />
      <icon-close
        class="mbox-close"
        src="{{assets.iconClose}}"
        size="{{64}}"
        bind:close="onClose"
      />

      <view class="mbox-content">
        <scroll-view class="mbox-list" scroll-y>
          <view
            wx:for="{{listItems}}"
            wx:key="instanceId"
            class="mbox-row {{item.isNew ? 'mbox-row--new' : ''}}"
            data-index="{{index}}"
            catchtap="onTapRow"
          >
            <image class="mbox-row-bg" src="{{assets.rowBg}}" mode="aspectFit" />
            <view class="mbox-row-body">
              <view class="mbox-thumb">
                <image
                  wx:if="{{item.imageThumb}}"
                  src="{{item.imageThumb}}"
                  mode="aspectFill"
                />
                <view wx:else class="mbox-thumb-ph">{{item.title[0] || '?'}}</view>
              </view>
              <text class="mbox-name">{{item.title || '明信片的名字'}}</text>
            </view>
          </view>
          <view wx:if="{{!listItems.length}}" class="mbox-empty">暂时没有未读信件</view>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- 明信片大图弹层（与 diary 共用组件）：裸图 + 信封跟随右下角 -->
  <postcard-zoom
    wx:if="{{detailVisible && !letterVisible}}"
    image="{{zoomImage}}"
    title="{{zoomTitle}}"
    envelope="{{assets.envelope}}"
    bind:close="onCloseDetail"
    bind:envelope="onTapEnvelope"
  />

  <diary-letter
    visible="{{letterVisible}}"
    date-text="{{letterDate}}"
    story="{{letterStory}}"
    title="{{zoomTitle}}"
    auto-claim="{{true}}"
    bind:close="onCloseLetter"
    bind:claim="onClaim"
  />
</view>
