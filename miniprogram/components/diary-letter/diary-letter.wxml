<view class="dl-mask" wx:if="{{visible}}" catchtap="onClose">
  <view class="dl-card" catchtap="onStop">
    <!-- 信纸即弹窗本体：letter-paper 作为背景（含 DATE 标签 / 天气 / logo），无圆角容器 -->
    <scroll-view class="dl-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        class="dl-paper"
        style="background-image: url('{{assets.paper}}')"
      >
        <view class="dl-paper-content">
          <text class="dl-date" wx:if="{{dateText}}">{{dateText}}</text>
          <view class="dl-story">
            <text wx:for="{{paragraphs}}" wx:key="index" class="dl-story-p">{{item}}</text>
            <text wx:if="{{paragraphs.length === 0}}" class="dl-story-p">（暂无信件内容）</text>
          </view>
          <text class="dl-sign" wx:if="{{signText}}">{{signText}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
