.dl-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

/* 无圆角容器：卡片即信纸，尺寸跟随信纸切图比例 */
.dl-card {
  width: 85vw;
  max-width: 640rpx;
  max-height: 82vh;
  box-sizing: border-box;
}

.dl-body {
  max-height: 82vh;
  overflow: hidden;
}

/* 信纸本体：letter-paper 切图（1681×2340）作 CSS 背景铺满，
   高度由 aspect-ratio 锁定，与背景图比例一致不变形 */
.dl-paper {
  position: relative;
  width: 100%;
  aspect-ratio: 1681 / 2340;
  background-size: 100% 100%;
  background-repeat: no-repeat;
}

/* 文字区域：四边偏移 = 距信纸各边的距离。
   left/right 百分比相对信纸宽度，top/bottom 百分比相对信纸高度 */
.dl-paper-content {
  position: absolute;
  left: 10%;    
  right: 10%;   
  top: 4.5%;
  bottom: 19%;  
  z-index: 1;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: 'PingFang SC', 'Heiti SC', sans-serif;
}

.dl-date {
  display: block;
  margin-bottom: 13%;
  margin-left: 19%;
  font-size: 100%;
  color: #9ab4e8;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.dl-story {
  flex: 1;
  font-size: 120%;
  line-height: 150%;
  color: #5a82d8;
}

/* 每个段落独立成块，首行缩进两个字；缩进量改 text-indent */
.dl-story-p {
  display: block;
  text-indent: 2em;
  margin-bottom: 12rpx;
  word-break: break-word;
}

.dl-sign {
  display: block;
  margin-top: 12%;
  text-align: right;
  font-size: 120%;
  line-height: 150%;
  color: #5a82d8;
  white-space: pre-wrap;
  word-break: break-word;
  flex-shrink: 0;
}
