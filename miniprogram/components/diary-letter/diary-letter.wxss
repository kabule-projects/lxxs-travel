.dl-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.dl-card {
  width: 85vw;
  max-width: 640rpx;
  max-height: 82vh;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 24rpx;
}

.dl-body {
  max-height: 82vh;
  overflow: hidden;
}

.dl-paper {
  position: relative;
  width: 100%;
}

.dl-paper-bg {
  position: relative;
  z-index: 0;
  width: 100%;
  display: block;
}

.dl-paper-content {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  padding: 28% 10% 23%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.dl-date {
  display: block;
  margin-bottom: 24rpx;
  font-size: 100%;
  color: #9ab4e8;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.dl-story {
  display: block;
  flex: 1;
  margin-top: 29rpx;
  font-size: 140%;
  line-height: 150%;
  color: #5a82d8;
  font-family: 'STKaiti', 'KaiTi', 'PingFang SC', serif;
  white-space: pre-wrap;
  word-break: break-word;
}

.dl-sign {
  display: block;
  margin-top: 10%;
  text-align: right;
  font-size: 120%;
  line-height: 120%;
  color: #5a82d8;
  font-family: 'STKaiti', 'KaiTi', 'PingFang SC', serif;
  white-space: pre-wrap;
  word-break: break-word;
  flex-shrink: 0;
}
