.sc-detail-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(20, 12, 8, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 面板：尺寸由底图 widthFix 按自身比例撑出，永不拉伸 */
.sc-detail-panel {
  position: relative;
  width: 620rpx;
}

.sc-detail-panel-bg {
  display: block;
  width: 100%;
}

.sc-detail-close {
  position: absolute;
  top: -18rpx;
  right: -18rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #5a3a22;
  color: #fff;
  font-size: 40rpx;
  line-height: 58rpx;
  text-align: center;
  z-index: 10;
}

/* 内容层：绝对铺满底图，浮于底图之上（z-index 保证文字不被遮） */
.sc-detail-content {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 四边留白相对面板宽，按 detail-panel 切图的内容区微调 */
  padding: 12% 10% 10%;
  box-sizing: border-box;
}

.sc-detail-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #5a3a22;
  line-height: 1.35;
  padding: 0 24rpx;
  /* 近似描边标题 */
  text-shadow:
    -2rpx -2rpx 0 #fffaf0,
    2rpx -2rpx 0 #fffaf0,
    -2rpx 2rpx 0 #fffaf0,
    2rpx 2rpx 0 #fffaf0;
}

.sc-detail-image {
  position: relative;
  margin: 24rpx auto 0;
  width: 58%;
  aspect-ratio: 1 / 1;
  border-radius: 16rpx;
  overflow: hidden;
}

.sc-detail-item-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.sc-detail-img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.sc-detail-img-ph {
  color: #f7efe0;
  font-size: 80rpx;
  font-weight: 700;
}

.sc-detail-desc {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.55;
  color: #2e2218;
  white-space: pre-wrap;
}

/* 底部确认按钮：复用扭蛋 btn-confirm 贴图，居中并贴向面板底部 */
.sc-detail-confirm {
  display: block;
  width: 52%;
  margin-top: auto;
}
