.trip-banner {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 25;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

/* 显式定高 = 屏宽 750rpx × 切图高宽比（trip-banner 1243×176 / return 1243×177），
   widthFix 加载前后同高不抖动 */
.trip-banner-img {
  width: 100%;
  height: 106rpx;
  display: block;
}
