.gp-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 110;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.gp-panel {
  position: relative;
  width: 620rpx;
  max-height: 78vh;
  padding: 36rpx 28rpx 40rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #f3e6cf;
  border: 6rpx dashed #5a3a22;
}

.gp-close {
  position: absolute;
  top: -22rpx;
  right: -18rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e8923a;
  color: #fff;
  font-size: 40rpx;
  line-height: 58rpx;
  text-align: center;
  z-index: 2;
}

.gp-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #5a3a22;
  margin-bottom: 24rpx;
}

.gp-scroll {
  max-height: 58vh;
}

.gp-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.gp-cell {
  width: calc((100% - 48rpx) / 4);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.gp-cell--on {
  background: #fff8e0;
  border: 4rpx solid #c49a6c;
}

.gp-cell--lock {
  background: #5a3a22;
  border: 4rpx solid #3a2410;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gp-icon {
  width: 100%;
  height: 100%;
}

.gp-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #6b4a2e;
}

.gp-q {
  font-size: 48rpx;
  font-weight: 700;
  color: #f0d878;
}
