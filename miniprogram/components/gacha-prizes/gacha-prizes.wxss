.gp-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 110;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 面板复用 gacha/result-panel 切图（1181×1359，奶白圆角面板）：宽度占屏 85.4% */
.gp-panel {
  position: relative;
  width: 85.4%;
}

.gp-panel-bg {
  display: block;
  width: 100%;
}

.gp-content {
  position: absolute;
  left: 6%;
  right: 6%;
  top: 6%;
  bottom: 5%;
  display: flex;
  flex-direction: column;
}

.gp-close {
  position: absolute;
  top: 2%;
  right: 2.5%;
  z-index: 2;
}

.gp-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 24%;
}

/* 等格：每行 4 个，格数 = 数据库物品数。
   格间距改 gap；每行 4 格有 3 个间隙，需同步改 .gp-cell width 里的 7.5%（= gap × 3） */
.gp-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 2.5%;
  row-gap: 16rpx;
}

.gp-cell {
  position: relative;
  width: calc((100% - 7.5%) / 4);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.gp-item-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 物品本体图标：相对卡片居中；改 width/height 百分比即可缩放 item 在格子中的大小 */
.gp-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 1;
  width: 78%;
  height: 78%;
}

.gp-q-wrap {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gp-q {
  font-size: 48rpx;
  font-weight: 700;
  color: #a06a32;
}
