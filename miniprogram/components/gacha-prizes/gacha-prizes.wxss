.gp-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 110;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 面板复用 gacha/result-panel 切图（1181×1359，奶白圆角面板）：宽度占屏 85.4% */
.gp-panel {
  position: relative;
  width: 85.4%;
}

.gp-panel-bg {
  display: block;
  width: 100%;
}

.gp-content {
  position: absolute;
  left: 6%;
  right: 6%;
  top: 6%;
  bottom: 5%;
  display: flex;
  flex-direction: column;
}

.gp-close {
  position: absolute;
  top: 2%;
  right: 2.5%;
  z-index: 2;
}

.gp-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #5a3a22;
  margin-bottom: 4%;
}

.gp-scroll {
  flex: 1;
  min-height: 0;
}

/* 等格：每行 4 个，格数 = 数据库物品数；格间距按面板宽百分比 */
.gp-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 2.5%;
}

.gp-cell {
  position: relative;
  width: calc((100% - 7.5%) / 4);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.gp-item-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.gp-icon {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.gp-q-wrap {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gp-q {
  font-size: 48rpx;
  font-weight: 700;
  color: #a06a32;
}
