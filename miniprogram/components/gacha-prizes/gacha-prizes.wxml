<view class="gp-mask" wx:if="{{visible}}" catchtap="onClose">
  <view class="gp-panel" catchtap="onStop">
    <image class="gp-panel-bg" src="{{panelBg}}" mode="widthFix" />
    <icon-close class="gp-close" src="{{iconClose}}" size="{{64}}" bind:tap="onClose" />
    <view class="gp-content">
      <view class="gp-title">奖品</view>

      <scroll-view class="gp-scroll" scroll-y>
      <view class="gp-grid">
        <view
          wx:for="{{items}}"
          wx:key="gachaId"
          class="gp-cell {{item.obtained ? 'gp-cell--on' : 'gp-cell--lock'}}"
        >
          <block wx:if="{{item.obtained}}">
            <!-- 已收集：底图 + 实物叠放 -->
            <image class="gp-item-bg" src="{{itemBg}}" mode="aspectFill" />
            <image
              wx:if="{{item.icon}}"
              class="gp-icon"
              src="{{item.icon}}"
              mode="aspectFit"
            />
          </block>
          <block wx:else>
            <!-- 未收集：框中叠加问号 -->
            <image class="gp-item-bg" src="{{lockIcon}}" mode="aspectFill" />
            <view class="gp-q-wrap"><text class="gp-q">?</text></view>
          </block>
        </view>
      </view>
      </scroll-view>
    </view>
  </view>
</view>
