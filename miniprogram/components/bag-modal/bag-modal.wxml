<view class="bag-mask" wx:if="{{visible}}" catchtap="onClose">
  <view class="bag-wrap" catchtap="onStop">
    <icon-close
      class="bag-close"
      src="{{iconClose}}"
      size="{{64}}"
      bind:tap="onClose"
    />

    <view class="bag-body">
      <!-- 背景已含槽位框与标签文案 -->
      <image class="bag-panel-bg" src="{{assets.panel}}" mode="widthFix" />

      <!-- 透明热区：物品图叠在背包背景槽位上 -->
      <view class="slot slot-food" catchtap="onTapFood">
        <view wx:if="{{food}}" class="slot-fill">
          <image wx:if="{{food.icon}}" class="slot-item-icon" src="{{food.icon}}" mode="aspectFit" />
          <image
            class="slot-clear"
            src="{{iconClose}}"
            mode="aspectFit"
            catchtap="onClearFood"
            data-stop="1"
          />
        </view>
      </view>

      <view class="slot slot-rice" catchtap="onTapRice">
        <view wx:if="{{riceStar}}" class="slot-fill">
          <text class="slot-rice-mark">米</text>
          <image
            class="slot-clear"
            src="{{iconClose}}"
            mode="aspectFit"
            catchtap="onClearRice"
          />
        </view>
        <text wx:elif="{{riceCount > 0}}" class="slot-hint">点选携带</text>
        <text wx:else class="slot-hint slot-hint--dim">暂无</text>
      </view>

      <view class="slot slot-prop0" data-index="0" catchtap="onTapProp">
        <view wx:if="{{props[0]}}" class="slot-fill">
          <image wx:if="{{props[0].icon}}" class="slot-item-icon" src="{{props[0].icon}}" mode="aspectFit" />
          <image
            class="slot-clear"
            src="{{iconClose}}"
            mode="aspectFit"
            data-index="0"
            catchtap="onClearProp"
          />
        </view>
      </view>

      <view class="slot slot-prop1" data-index="1" catchtap="onTapProp">
        <view wx:if="{{props[1]}}" class="slot-fill">
          <image wx:if="{{props[1].icon}}" class="slot-item-icon" src="{{props[1].icon}}" mode="aspectFit" />
          <image
            class="slot-clear"
            src="{{iconClose}}"
            mode="aspectFit"
            data-index="1"
            catchtap="onClearProp"
          />
        </view>
      </view>
    </view>

    <!-- 出发按钮图已含 GO 气泡 -->
    <view class="depart-area">
      <image
        class="depart-btn-img"
        src="{{assets.btnDepart}}"
        mode="widthFix"
        catchtap="onDepart"
      />
    </view>
  </view>

  <inventory-picker
    visible="{{pickerVisible}}"
    lock-tab="{{pickerLock}}"
    bind:close="onPickerClose"
    bind:select="onPickerSelect"
  />
</view>
