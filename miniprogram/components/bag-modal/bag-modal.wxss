.bag-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(10, 6, 4, 0.72);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bag-wrap {
  position: relative;
  width: 680rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bag-close {
  position: absolute;
  top: -8rpx;
  right: 24rpx;
  z-index: 3;
}

.bag-body {
  position: relative;
  width: 620rpx;
  height: 720rpx;
  overflow: hidden;
}

.bag-panel-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bag-label {
  position: absolute;
  z-index: 2;
  height: 28rpx;
}

.bag-label--food {
  left: 80rpx;
  top: 96rpx;
}

.bag-label--rice {
  right: 96rpx;
  top: 96rpx;
}

.bag-label--prop {
  left: 80rpx;
  top: 340rpx;
}

.slot {
  position: absolute;
  z-index: 2;
  width: 148rpx;
  height: 148rpx;
  box-sizing: border-box;
}

.slot-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.slot-food {
  left: 90rpx;
  top: 140rpx;
}

.slot-rice {
  right: 90rpx;
  top: 140rpx;
}

.slot-prop0 {
  left: 120rpx;
  top: 390rpx;
}

.slot-prop1 {
  right: 120rpx;
  top: 390rpx;
}

.slot-fill {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
}

.slot-item-icon {
  width: 72rpx;
  height: 72rpx;
}

.slot-name {
  font-size: 22rpx;
  color: #4a3728;
  text-align: center;
  line-height: 1.3;
}

.slot-clear {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
}

.slot-hint {
  position: relative;
  z-index: 1;
  display: block;
  width: 100%;
  height: 100%;
  line-height: 148rpx;
  text-align: center;
  font-size: 22rpx;
  color: #5a4030;
}

.slot-hint--dim {
  color: rgba(90, 64, 48, 0.45);
}

.depart-area {
  position: relative;
  margin-top: 36rpx;
  width: 420rpx;
}

.go-bubble-img {
  position: absolute;
  left: 24rpx;
  top: -36rpx;
  width: 100rpx;
}

.depart-btn-img {
  width: 100%;
  height: 96rpx;
}
