.bag-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(10, 6, 4, 0.72);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bag-wrap {
  position: relative;
  width: 90.7%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bag-close {
  position: absolute;
  top: -8rpx;
  right: 24rpx;
  z-index: 3;
}

.bag-body {
  position: relative;
  width: 82.7%;
  overflow: hidden;
  border-radius: 28rpx;
}

.bag-panel-bg {
  position: relative;
  z-index: 0;
  width: 100%;
  display: block;
}

/* 透明热区按 bag/panel 切图（1707×2809）的相对坐标标定，随面板等比缩放 */
.slot {
  position: absolute;
  z-index: 2;
  width: 23.4%;
  height: 14.2%;
  box-sizing: border-box;
}

.slot-food {
  left: 25.8%;
  top: 27.9%;
}

.slot-rice {
  left: 55.4%;
  top: 27.9%;
}

.slot-prop0 {
  left: 37.8%;
  top: 50.6%;
}

.slot-prop1 {
  left: 67.4%;
  top: 50.6%;
}

.slot-fill {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.slot-item-icon {
  width: 62%;
  height: 62%;
}

.slot-rice-mark {
  font-size: 48rpx;
  font-weight: 700;
  color: #e8a830;
}

.slot-clear {
  position: absolute;
  top: -8%;
  right: -8%;
  width: 28%;
  height: 28%;
  z-index: 2;
}

.slot-hint {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 22rpx;
  color: #5a4030;
}

.slot-hint--dim {
  color: rgba(90, 64, 48, 0.45);
}

.depart-area {
  position: relative;
  margin-top: 36rpx;
  width: 68%;
}

.depart-btn-img {
  width: 100%;
  display: block;
}
