.sett-root {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
}

.sett-backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sett-panel {
  position: relative;
  width: 600rpx;
  min-height: 520rpx;
  /* 顶部留白给背景内嵌的「设置」标题 */
  padding: 120rpx 40rpx 40rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 40rpx;
  background: #fff4d1;
  border: 4rpx solid #d4a574;
}

.sett-panel-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.sett-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  padding: 0 8rpx;
}

.sett-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #5a3a22;
  letter-spacing: 2rpx;
}

.sett-toggle {
  width: 140rpx;
  height: 64rpx;
}

.sett-row--notify .sett-notify-btns {
  display: flex;
  gap: 12rpx;
}

.sett-notify-btn {
  min-width: 72rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #8a6a4a;
  background: #f0dcc0;
}

.sett-notify-btn--on {
  color: #fff8ee;
  background: #c47a3a;
}

.sett-user-bar {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sett-user-bar-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
  background: #8b5a3c;
}

.sett-user-id {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff8ee;
  letter-spacing: 1rpx;
}

.sett-footer {
  position: relative;
  z-index: 1;
  margin-top: 32rpx;
  text-align: center;
}

.sett-version {
  display: block;
  font-size: 22rpx;
  color: #8a7463;
  line-height: 1.6;
}

.sett-brand {
  display: block;
  font-size: 20rpx;
  color: #a08878;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}
