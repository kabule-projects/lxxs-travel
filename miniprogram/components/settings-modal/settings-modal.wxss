.sett-root {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
}

.sett-backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 面板宽高双锁（600×798rpx = 切图 1029×1369 等比）：
   容器尺寸不依赖任何远程图片的加载时机/widthFix 行为，首帧即定型，
   热区坐标所有机型、平台完全一致 */
.sett-panel {
  position: relative;
  width: 600rpx;
  height: 798rpx;
}

.sett-panel-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 音乐/音效开关（toggle 切图 261×111）：宽 25%，高 8%。
   水平落在左角色与右脸之间（left 47.5%，右缘 72.5%）；
   垂直按底图两行中心 y 25.1% / 41.2% 标定 */
.sett-toggle {
  position: absolute;
  width: 25%;
  height: 8%;
  z-index: 1;
}

.sett-toggle--music {
  left: 47.5%;
  top: 22.5%;
}

.sett-toggle--sfx {
  left: 47.5%;
  top: 38%;
}

/* 通知开/关按钮（notification-* 168×108）：各宽 16%、高 7.7%、间距 4%，
   与底图「通知」行中心 y≈57.5% 对齐 */
.sett-notify-btn {
  position: absolute;
  width: 16%;
  height: 7.7%;
  z-index: 1;
}

.sett-notify--on {
  left: 40%;
  top: 53.6%;
}

.sett-notify--off {
  left: 60%;
  top: 53.6%;
}

/* 兑换码入口（redeem-btn 819×99，贴图含文字）：宽 83.3%、高 7.6%，水平居中 */
.sett-redeem-entry {
  position: absolute;
  left: 50%;
  top: 64%;
  transform: translateX(-50%);
  width: 83.3%;
  height: 7.6%;
  z-index: 1;
}

/* user-id-bar（824×156）：贴图即整条 bar，宽 84%、高 12%，文字绝对居中叠放 */
.sett-user-bar {
  position: absolute;
  left: 8%;
  top: 73.5%;
  width: 84%;
  height: 12%;
  z-index: 1;
}

.sett-user-bar-bg {
  width: 100%;
  height: 100%;
}

.sett-user-id {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff8ee;
  letter-spacing: 1rpx;
}

.sett-footer {
  position: absolute;
  left: 0;
  right: 0;
  top: 86.8%;
  z-index: 1;
  text-align: center;
}

.sett-version {
  display: block;
  font-size: 19rpx;
  color: #8a7463;
  line-height: 1.0;
}

.sett-brand {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  color: #a08878;
  letter-spacing: 2rpx;
}
