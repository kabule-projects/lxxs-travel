.sett-root {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
}

.sett-backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 面板由贴图定形（1029×1369 竖版）：widthFix 定高，尺寸/圆角/边框全部来自贴图 */
.sett-panel {
  position: relative;
  width: 600rpx;
}

.sett-panel-bg {
  display: block;
  width: 100%;
}

/* 内容区相对贴图百分比定位；top 需让开贴图内嵌的标题 */
.sett-content {
  position: absolute;
  left: 8%;
  right: 8%;
  top: 23%;
  bottom: 6%;
  display: flex;
  flex-direction: column;
}

.sett-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 67rpx;
  margin-right: 10rpx;
}

.sett-toggle {
  /* toggle 大小：width 定宽，高度随切图比例 */
  width: 140rpx;
}

/* user-bar 起到底部锚点作用：margin-top:auto 把它和 footer 一起压到内容区底部 */
.sett-user-bar {
  position: relative;
  z-index: 1;
  margin-top: auto;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sett-user-bar-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
  background: #8b5a3c;
}

.sett-user-id {
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff8ee;
  letter-spacing: 1rpx;
}

.sett-footer {
  position: relative;
  z-index: 1;
  margin-top: 32rpx;
  text-align: center;
}

.sett-version {
  display: block;
  font-size: 22rpx;
  color: #8a7463;
  line-height: 1.6;
}

.sett-brand {
  display: block;
  font-size: 20rpx;
  color: #a08878;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}
