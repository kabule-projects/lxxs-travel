<view class="gr-mask" wx:if="{{visible}}" catchtap="onClose">
  <view class="gr-panel" catchtap="onStop">
    <image class="gr-panel-bg" src="{{panelBg}}" mode="scaleToFill" />
    <icon-close class="gr-close" src="{{iconClose}}" size="{{64}}" bind:tap="onClose" />
    <view class="gr-title">恭喜获得</view>

    <view wx:if="{{single}}" class="gr-single">
      <view
        class="gr-item gr-item--lg {{convertFlags[0] && results[0].duplicate ? 'gr-item--converted' : ''}}"
      >
        <image class="gr-item-bg" src="{{itemBg}}" mode="aspectFill" />
        <image
          wx:if="{{results[0].icon}}"
          class="gr-icon"
          src="{{results[0].icon}}"
          mode="aspectFit"
        />
        <view class="gr-dim"></view>
        <image wx:if="{{iconStar}}" class="gr-star" src="{{iconStar}}" mode="aspectFit" />
      </view>
    </view>

    <view wx:else class="gr-multi">
      <view class="gr-row">
        <view
          wx:for="{{topRow}}"
          wx:key="gachaId"
          class="gr-item {{convertFlags[index] && item.duplicate ? 'gr-item--converted' : ''}}"
        >
          <image class="gr-item-bg" src="{{itemBg}}" mode="aspectFill" />
          <image wx:if="{{item.icon}}" class="gr-icon" src="{{item.icon}}" mode="aspectFit" />
          <view class="gr-dim"></view>
          <image wx:if="{{iconStar}}" class="gr-star" src="{{iconStar}}" mode="aspectFit" />
        </view>
      </view>
      <view class="gr-row gr-row--center">
        <view
          wx:for="{{bottomRow}}"
          wx:for-index="bi"
          wx:key="gachaId"
          class="gr-item {{convertFlags[bi + 3] && item.duplicate ? 'gr-item--converted' : ''}}"
        >
          <image class="gr-item-bg" src="{{itemBg}}" mode="aspectFill" />
          <image wx:if="{{item.icon}}" class="gr-icon" src="{{item.icon}}" mode="aspectFit" />
          <view class="gr-dim"></view>
          <image wx:if="{{iconStar}}" class="gr-star" src="{{iconStar}}" mode="aspectFit" />
        </view>
      </view>
    </view>

    <image class="gr-confirm-img" src="{{btnConfirm}}" mode="widthFix" catchtap="onConfirm" />
  </view>
</view>
