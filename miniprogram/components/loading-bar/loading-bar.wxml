<view class="loading-bar">
  <view class="track">
    <!-- 轨道底图 WebP -->
    <image class="track-img" src="{{displayTrack}}" mode="scaleToFill" binderror="onTrackError" />
    <!-- 进度填充 WebP，宽度随 progress 裁剪 -->
    <view class="fill-clip" style="width: {{progress}}%">
      <image class="fill-img" src="{{displayFill}}" mode="scaleToFill" />
    </view>
    <!-- 米子图标：贴在已填充进度末端跟随 -->
    <image
      class="thumb-img"
      src="{{displayThumb}}"
      mode="aspectFit"
      style="left: {{progress}}%"
    />
  </view>
</view>
