.loading-bar {
  width: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.track {
  position: relative;
  width: 520rpx;
  max-width: calc(100vw - 80rpx);
  height: 48rpx;
  margin: 24rpx auto;
  border-radius: 999rpx;
  overflow: visible;
}

.track-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
}

.fill-clip {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  overflow: hidden;
  border-radius: 999rpx 0 0 999rpx;
  transition: width 0.25s ease-out;
  z-index: 1;
}

.fill-img {
  width: 520rpx;
  max-width: calc(100vw - 80rpx);
  height: 100%;
  display: block;
}

/* 米子贴在进度末端，高约进度条 1.3 倍（条高 48rpx → 62rpx）；
   aspectFit 等比缩放：横版变装米占满高度，方形原皮米也为 62×62 */
.thumb-img {
  position: absolute;
  top: 50%;
  width: 110rpx;
  height: 62rpx;
  transform: translate(-50%, -50%);
  z-index: 2;
  transition: left 0.25s ease-out;
  pointer-events: none;
}

/* 变装米（横版图）比原皮再大约 10% */
.thumb-img--skin {
  width: 120rpx;
  height: 68rpx;
}
